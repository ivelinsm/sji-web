---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/utils';

const lang = 'bg';
const base = import.meta.env.BASE_URL;

const iconDelivery = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="2 0 21 21" fill="currentColor" aria-hidden="true">
  <path d="M21.47,11.185l-1.03-1.43a2.5,2.5,0,0,0-2.03-1.05H14.03V6.565a2.5,2.5,0,0,0-2.5-2.5H4.56a2.507,2.507,0,0,0-2.5,2.5v9.94a1.5,1.5,0,0,0,1.5,1.5H4.78a2.242,2.242,0,0,0,4.44,0h5.56a2.242,2.242,0,0,0,4.44,0h1.22a1.5,1.5,0,0,0,1.5-1.5v-3.87A2.508,2.508,0,0,0,21.47,11.185ZM7,18.935a1.25,1.25,0,1,1,1.25-1.25A1.25,1.25,0,0,1,7,18.935Zm6.03-1.93H9.15a2.257,2.257,0,0,0-4.3,0H3.56a.5.5,0,0,1-.5-.5V6.565a1.5,1.5,0,0,1,1.5-1.5h6.97a1.5,1.5,0,0,1,1.5,1.5ZM17,18.935a1.25,1.25,0,1,1,1.25-1.25A1.25,1.25,0,0,1,17,18.935Zm3.94-2.43a.5.5,0,0,1-.5.5H19.15a2.257,2.257,0,0,0-4.3,0h-.82v-7.3h4.38a1.516,1.516,0,0,1,1.22.63l1.03,1.43a1.527,1.527,0,0,1,.28.87Z" />
  <path d="M18.029,12.205h-2a.5.5,0,0,1,0-1h2a.5.5,0,0,1,0,1Z" />
</svg>`;

const iconMaintenance = `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M14 3L5 6.5v7C5 18.5 9 22.5 14 25c5-2.5 9-6.5 9-11.5v-7L14 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  <path d="M10 14l2.5 2.5 5.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

const iconCO2 = `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect x="9" y="5" width="10" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
  <path d="M12 5V3h4v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="14" cy="13" r="1.2" fill="currentColor"/>
  <circle cx="14" cy="9" r="0.8" fill="currentColor" opacity="0.6"/>
  <circle cx="11" cy="11" r="0.8" fill="currentColor" opacity="0.5"/>
  <circle cx="17" cy="11" r="0.8" fill="currentColor" opacity="0.5"/>
</svg>`;

const services = [
  {
    icon: iconDelivery,
    titleKey: 'services.home.delivery.title',
    descKey: 'services.home.delivery.body',
    ctaKey: 'services.home.delivery.cta',
    ctaHref: `${base}contact?type=delivery`,
  },
  {
    icon: iconMaintenance,
    titleKey: 'services.home.maintenance.title',
    descKey: 'services.home.maintenance.body',
    ctaKey: 'services.home.maintenance.cta',
    ctaHref: `${base}contact?type=delivery`,
  },
  {
    icon: iconCO2,
    titleKey: 'services.home.co2.title',
    descKey: 'services.home.co2.body',
    ctaKey: 'services.home.co2.cta',
    ctaHref: `${base}contact?type=delivery`,
  },
];

const steps = [1, 2, 3].map((n) => ({
  num: `0${n}`,
  titleKey: `uslugi.how.step${n}.title`,
  bodyKey: `uslugi.how.step${n}.body`,
}));
---

<Layout
  title={t(lang, 'uslugi.page.title')}
  description={t(lang, 'uslugi.page.description')}
  titleKey="uslugi.page.title"
  descriptionKey="uslugi.page.description"
>

  <SiteHeader slot="header" lang={lang} />

  <PageHero
    lang={lang}
    eyebrowKey="uslugi.hero.eyebrow"
    titleKey="uslugi.hero.title"
    subtitleKey="uslugi.hero.subtitle"
  />

  <!-- ── Services ───────────────────────────────────────────── -->
  <section class="svc">
    <div class="container">
      <div class="svc__grid">
        {services.map((card) => (
          <ServiceCard
            icon={card.icon}
            title={t(lang, card.titleKey)}
            titleKey={card.titleKey}
            description={t(lang, card.descKey)}
            descKey={card.descKey}
            ctaLabel={t(lang, card.ctaKey)}
            ctaKey={card.ctaKey}
            ctaHref={card.ctaHref}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ── How ordering works ─────────────────────────────────── -->
  <section class="how">
    <div class="container">
      <h2 class="how__title">
        <span data-i18n="uslugi.how.title">{t(lang, 'uslugi.how.title')}</span>
      </h2>

      <ol class="how__steps" role="list">
        {steps.map((s) => (
          <li class="how__step">
            <span class="how__num" aria-hidden="true">{s.num}</span>
            <h3 class="how__step-title">
              <span data-i18n={s.titleKey}>{t(lang, s.titleKey)}</span>
            </h3>
            <p class="how__step-body">
              <span data-i18n={s.bodyKey}>{t(lang, s.bodyKey)}</span>
            </p>
          </li>
        ))}
      </ol>

      <div class="how__area">
        <span class="how__area-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.75"/>
          </svg>
        </span>
        <div>
          <h3 class="how__area-title">
            <span data-i18n="uslugi.area.title">{t(lang, 'uslugi.area.title')}</span>
          </h3>
          <p class="how__area-body">
            <span data-i18n="uslugi.area.body">{t(lang, 'uslugi.area.body')}</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Closing CTA ────────────────────────────────────────── -->
  <section class="closing-band">
    <div class="container closing-band__inner">
      <h2 class="closing-band__title">
        <span data-i18n="uslugi.cta.title">{t(lang, 'uslugi.cta.title')}</span>
      </h2>
      <p class="closing-band__body">
        <span data-i18n="uslugi.cta.body">{t(lang, 'uslugi.cta.body')}</span>
      </p>
      <div class="closing-band__actions">
        <Button variant="primary" size="lg" href={`${base}contact?type=delivery`}>
          <span data-i18n="uslugi.cta.button">{t(lang, 'uslugi.cta.button')}</span>
        </Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />

</Layout>

<style>
  .svc {
    background:    var(--color-bg);
    padding-block: var(--space-4) var(--space-20);
  }

  .svc__grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-6);
    align-items:           stretch;
  }

  /* ── How it works ───────────────────────────────────────── */
  .how {
    background:    var(--color-surface);
    padding-block: var(--space-20);
  }

  .how__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-10);
  }

  .how__steps {
    list-style:            none;
    margin:                0 0 var(--space-12);
    padding:               0;
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-6);
  }

  .how__step {
    border-top:  2px solid var(--color-border-light);
    padding-top: var(--space-5);
    position:    relative;
  }

  .how__num {
    display:        block;
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-2xl);
    color:          var(--color-secondary);
    letter-spacing: -0.01em;
    line-height:    1;
    margin-bottom:  var(--space-3);
  }

  .how__step-title {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size:   var(--text-xl);
    color:       var(--color-primary);
    margin:      0 0 var(--space-2);
  }

  .how__step-body {
    font-size:   var(--text-base);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      0;
  }

  .how__area {
    display:       flex;
    gap:           var(--space-5);
    align-items:   flex-start;
    background:    var(--color-tint);
    border-radius: var(--radius-lg);
    padding:       var(--space-8);
  }

  .how__area-icon {
    flex-shrink:     0;
    width:           44px;
    height:          44px;
    border-radius:   var(--radius-md);
    background:      var(--color-surface);
    color:           var(--color-secondary-hover);
    display:         flex;
    align-items:     center;
    justify-content: center;
  }

  .how__area-title {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size:   var(--text-xl);
    color:       var(--color-primary);
    margin:      0 0 var(--space-2);
  }

  .how__area-body {
    font-size:   var(--text-base);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0;
  }

  /* ── Closing band ───────────────────────────────────────── */
  .closing-band {
    background:    var(--color-bg);
    border-top:    1px solid var(--color-border-light);
    padding-block: var(--space-20);
  }

  .closing-band__inner {
    text-align: center;
    max-width:  620px;
  }

  .closing-band__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    margin:         0 0 var(--space-4);
  }

  .closing-band__body {
    font-size:   var(--text-lg);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      0 0 var(--space-8);
  }

  .closing-band__actions {
    display:         flex;
    justify-content: center;
    gap:             var(--space-4);
  }

  @media (max-width: 1024px) {
    .svc__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .how,
    .closing-band { padding-block: var(--space-16); }
    .how__steps { grid-template-columns: 1fr; }
    .how__area { flex-direction: column; }
  }
</style>
