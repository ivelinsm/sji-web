---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/utils';

const lang = 'bg';
const base = import.meta.env.BASE_URL;

const questions = Array.from({ length: 10 }, (_, i) => ({
  qKey: `faq.q${i + 1}.q`,
  aKey: `faq.q${i + 1}.a`,
}));

// FAQPage rich-result schema from the Bulgarian (canonical) copy.
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((q) => ({
    '@type': 'Question',
    name: t(lang, q.qKey),
    acceptedAnswer: { '@type': 'Answer', text: t(lang, q.aKey) },
  })),
});
---

<Layout
  title={t(lang, 'faq.page.title')}
  description={t(lang, 'faq.page.description')}
  titleKey="faq.page.title"
  descriptionKey="faq.page.description"
>
  <script type="application/ld+json" slot="head" set:html={faqSchema} />

  <SiteHeader slot="header" lang={lang} />

  <PageHero
    lang={lang}
    titleKey="faq.hero.title"
    subtitleKey="faq.hero.subtitle"
  />

  <section class="faq">
    <div class="container">
      <div class="faq__list">
        {questions.map((q) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span data-i18n={q.qKey}>{t(lang, q.qKey)}</span>
              <span class="faq__chevron" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                  <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <p class="faq__a">
              <span data-i18n={q.aKey}>{t(lang, q.aKey)}</span>
            </p>
          </details>
        ))}
      </div>

      <div class="faq__cta">
        <p class="faq__cta-text">
          <span data-i18n="kachestvo.cta.body">{t(lang, 'kachestvo.cta.body')}</span>
        </p>
        <Button variant="primary" href={`${base}contact`}>
          <span data-i18n="home.cta.secondary">{t(lang, 'home.cta.secondary')}</span>
        </Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />

</Layout>

<style>
  .faq {
    background:    var(--color-bg);
    padding-block: var(--space-4) var(--space-20);
  }

  .faq__list {
    max-width:      768px;
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
  }

  .faq__item {
    background:    var(--color-surface);
    border:        1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow:      hidden;
    transition:    border-color var(--transition-base);
  }

  .faq__item[open] {
    border-color: var(--color-secondary);
  }

  .faq__q {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             var(--space-4);
    padding:         var(--space-5) var(--space-6);
    font-family:     var(--font-heading);
    font-weight:     var(--font-weight-semibold);
    font-size:       var(--text-lg);
    color:           var(--color-primary);
    cursor:          pointer;
    list-style:      none;
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__q:focus-visible {
    outline:        2px solid var(--color-secondary);
    outline-offset: -2px;
  }

  .faq__chevron {
    flex-shrink: 0;
    color:       var(--color-text-muted);
    transition:  transform var(--transition-base);
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
    color:     var(--color-secondary-hover);
  }

  .faq__a {
    padding:     0 var(--space-6) var(--space-6);
    font-size:   var(--text-base);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0;
    max-width:   64ch;
  }

  .faq__cta {
    max-width:   768px;
    margin-top:  var(--space-10);
    display:     flex;
    align-items: center;
    gap:         var(--space-6);
    flex-wrap:   wrap;
  }

  .faq__cta-text {
    font-size: var(--text-base);
    color:     var(--color-text-muted);
    margin:    0;
  }

  @media (max-width: 768px) {
    .faq { padding-block: var(--space-2) var(--space-16); }
  }
</style>
