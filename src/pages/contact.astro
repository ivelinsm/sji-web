---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Navbar from '../components/Navbar.astro';
import NavLink from '../components/NavLink.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import Badge from '../components/Badge.astro';
import ContactForm from '../components/ContactForm.astro';
import { t } from '../i18n/utils';
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import Footer from '../components/Footer.astro';

const lang = 'bg';
const base = import.meta.env.BASE_URL;

// Local SEO: address, geo, and hours only. Phone/email are deliberately
// omitted — the site obfuscates them from scrapers by design.
const localBusinessSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'СЖИ Груп ЕООД',
  alternateName: 'SJI Group Ltd',
  url: 'https://sjigrup.com/',
  image: 'https://sjigrup.com/og-image.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Калиакра 54',
    addressLocality: 'Добрич',
    postalCode: '9300',
    addressCountry: 'BG',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.578623,
    longitude: 27.817627,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
  ],
  sameAs: ['https://www.facebook.com/aquavivawater/'],
});
---

<Layout
  title={t(lang, 'contact.page.title')}
  description={t(lang, 'contact.page.description')}
  titleKey="contact.page.title"
  descriptionKey="contact.page.description"
>
  <script type="application/ld+json" slot="head" set:html={localBusinessSchema} />

  <!-- ── Navbar ─────────────────────────────────────────────── -->
  <Navbar slot="header" variant="transparent">
    <Image slot="logo" src={logo} alt="SJI" class="nav-logo" />
    <NavLink slot="links" href={base}><span data-i18n="nav.home">{t(lang, 'nav.home')}</span></NavLink>
    <NavLink slot="links" href={`${base}products`}><span data-i18n="nav.products">{t(lang, 'nav.products')}</span></NavLink>
    <NavLink slot="links" href={`${base}about`}><span data-i18n="nav.about">{t(lang, 'nav.about')}</span></NavLink>
    <NavLink slot="links" href={`${base}contact`}><span data-i18n="nav.contact">{t(lang, 'nav.contact')}</span></NavLink>
    <Button slot="actions" variant="ghost" href={`${base}contact`} size="sm">
      <span data-i18n="nav.cta.enquiry">{t(lang, 'nav.cta.enquiry')}</span>
    </Button>
    <LangSwitcher slot="actions" />
  </Navbar>

  <!-- ── Page hero ──────────────────────────────────────────── -->
  <div class="page-hero">
    <div class="page-hero__bg" aria-hidden="true"></div>
    <div class="container">
      <div class="page-hero__inner">
        <Badge variant="secondary">
          <span data-i18n="contact.hero.eyebrow">{t(lang, 'contact.hero.eyebrow')}</span>
        </Badge>
        <h1 class="page-hero__title">
          <span data-i18n="contact.hero.title">{t(lang, 'contact.hero.title')}</span>
        </h1>
        <p class="page-hero__subtitle">
          <span data-i18n="contact.hero.subtitle">{t(lang, 'contact.hero.subtitle')}</span>
        </p>
      </div>
    </div>
  </div>

  <!-- ── Contact section ─────────────────────────────────────── -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <ContactForm />

        <aside class="contact-info" aria-labelledby="contact-info-title">
          <h2 id="contact-info-title" class="contact-info__title">
            <span data-i18n="contact.info.title">{t(lang, 'contact.info.title')}</span>
          </h2>

          <ul class="contact-info__list">
            <li class="contact-info__item">
              <span class="contact-info__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M4 6h16v12H4z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                  <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                <p class="contact-info__label">
                  <span data-i18n="contact.info.email.label">{t(lang, 'contact.info.email.label')}</span>
                </p>
                <p class="contact-info__value">
                  <a
                    class="obfuscated-email"
                    href="#"
                    data-user="sjigrup"
                    data-domain="abv.bg"
                    aria-label="Email"
                  >sjigrup <span aria-hidden="true">[at]</span><span class="visually-hidden"> at </span> abv.bg</a>
                </p>
              </div>
            </li>

            <li class="contact-info__item">
              <span class="contact-info__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                <p class="contact-info__label">
                  <span data-i18n="contact.info.phone.label.orders">{t(lang, 'contact.info.phone.label.orders')}</span>
                </p>
                <p class="contact-info__value">
                  <a
                    class="obfuscated-phone"
                    href="#"
                    data-cc="359"
                    data-rest="896730843"
                    data-display="896 730 843"
                    aria-label="Phone for orders and deliveries"
                  >+359 <span aria-hidden="true">[click to reveal]</span></a>
                </p>
              </div>
            </li>

            <li class="contact-info__item">
              <span class="contact-info__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                <p class="contact-info__label">
                  <span data-i18n="contact.info.phone.label.business">{t(lang, 'contact.info.phone.label.business')}</span>
                </p>
                <p class="contact-info__value">
                  <a
                    class="obfuscated-phone"
                    href="#"
                    data-cc="359"
                    data-rest="896697480"
                    data-display="896 697 480"
                    aria-label="Phone for business inquiries"
                  >+359 <span aria-hidden="true">[click to reveal]</span></a>
                </p>
              </div>
            </li>

            <li class="contact-info__item">
              <span class="contact-info__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                  <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.75"/>
                </svg>
              </span>
              <div>
                <p class="contact-info__label">
                  <span data-i18n="contact.info.address.label">{t(lang, 'contact.info.address.label')}</span>
                </p>
                <p class="contact-info__value">
                  <span data-i18n="contact.info.address.value">{t(lang, 'contact.info.address.value')}</span>
                </p>
              </div>
            </li>

            <li class="contact-info__item">
              <span class="contact-info__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/>
                  <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              </span>
              <div>
                <p class="contact-info__label">
                  <span data-i18n="contact.info.hours.label">{t(lang, 'contact.info.hours.label')}</span>
                </p>
                <p class="contact-info__value">
                  <span data-i18n="contact.info.hours.value">{t(lang, 'contact.info.hours.value')}</span>
                </p>
              </div>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Map section ────────────────────────────────────────── -->
  <section class="map-section" id="map">
    <div class="container">
      <div class="map-section__header">
        <span class="map-section__eyebrow">
          <span data-i18n="contact.hero.eyebrow">{t(lang, 'contact.hero.eyebrow')}</span>
        </span>
        <h2 class="map-section__title">
          <span data-i18n="contact.map.title">{t(lang, 'contact.map.title')}</span>
        </h2>
      </div>

      <div class="map-section__map-wrap">
        <iframe
          src="https://www.openstreetmap.org/export/embed.html?bbox=27.797627%2C43.568623%2C27.837627%2C43.588623&layer=mapnik&marker=43.578623%2C27.817627"
          class="map-section__iframe"
          loading="lazy"
          title="СЖИ - Местоположение"
          aria-label="Карта с местоположение на СЖИ в Добрич, ул. Калиакра 54"
        ></iframe>
      </div>

      <div class="map-section__cta">
        <a
          href="https://www.google.com/maps/search/?api=1&query=%D1%83%D0%BB.%20%D0%9A%D0%B0%D0%BB%D0%B8%D0%B0%D0%BA%D1%80%D0%B0%2054%2C%20%D0%94%D0%BE%D0%B1%D1%80%D0%B8%D1%87"
          class="map-section__directions-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.75"/>
          </svg>
          <span data-i18n="contact.map.directions">{t(lang, 'contact.map.directions')}</span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />

</Layout>

<script>
  // Reveal obfuscated email/phone after page load. Harvesters that don't run JS
  // see only "office [at] sji.bg" and "+359 [click to reveal]" — no parseable
  // mailto:/tel: link, no full address in the page source.
  type EmailAnchor = HTMLAnchorElement & { dataset: { user?: string; domain?: string } };
  type PhoneAnchor = HTMLAnchorElement & {
    dataset: { cc?: string; rest?: string; display?: string };
  };

  document.querySelectorAll<EmailAnchor>('a.obfuscated-email').forEach((a) => {
    const user = a.dataset.user;
    const domain = a.dataset.domain;
    if (!user || !domain) return;
    const address = `${user}@${domain}`;
    a.href = `mailto:${address}`;
    a.textContent = address;
  });

  document.querySelectorAll<PhoneAnchor>('a.obfuscated-phone').forEach((a) => {
    const cc = a.dataset.cc;
    const rest = a.dataset.rest;
    const display = a.dataset.display ?? rest;
    if (!cc || !rest) return;
    a.href = `tel:+${cc}${rest}`;
    a.textContent = `+${cc} ${display}`;
  });
</script>

<style>
  .nav-logo {
    height:     52px;
    width:      auto;
    display:    block;
    object-fit: contain;
  }

  /* ── Page hero ─────────────────────────────────────────── */
  .page-hero {
    position:   relative;
    background-color: var(--color-primary);
    margin-top:       -72px;
    padding-top:      calc(72px + var(--space-20));
    padding-bottom:   var(--space-16);
    overflow:         hidden;
  }

  .page-hero__bg {
    position:   absolute;
    inset:      0;
    background: radial-gradient(ellipse at 80% 30%, rgba(39, 169, 216, 0.28) 0%, transparent 60%),
                radial-gradient(ellipse at 10% 90%, rgba(255, 255, 255, 0.05) 0%, transparent 55%);
    pointer-events: none;
  }

  .page-hero .container {
    position: relative;
    z-index:  1;
  }

  .page-hero__inner {
    max-width: 640px;
  }

  .page-hero__title {
    font-family:   var(--font-heading);
    font-weight:   var(--font-weight-bold);
    font-size:     var(--text-5xl);
    color:         var(--color-white);
    line-height:   var(--leading-tight);
    margin-top:    var(--space-4);
    margin-bottom: 0;
  }

  .page-hero__subtitle {
    font-size:   var(--text-lg);
    color:       rgba(255, 255, 255, 0.78);
    line-height: var(--leading-relaxed);
    margin-top:  var(--space-4);
    max-width:   560px;
  }

  /* ── Contact section ───────────────────────────────────── */
  .contact-section {
    background-color: var(--color-bg);
    padding-block:    var(--space-20);
  }

  .contact-grid {
    display:               grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap:                   var(--space-10);
    align-items:           start;
  }

  /* ── Contact info aside ────────────────────────────────── */
  .contact-info {
    background:    var(--color-surface);
    border:        1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding:       var(--space-8);
    box-shadow:    var(--shadow-sm);
    position:      sticky;
    top:           calc(72px + var(--space-4));
  }

  .contact-info__title {
    font-family:  var(--font-heading);
    font-weight:  var(--font-weight-semibold);
    font-size:    var(--text-lg);
    color:        var(--color-primary);
    line-height:  var(--leading-tight);
    margin:       0 0 var(--space-6);
  }

  .contact-info__list {
    list-style: none;
    padding:    0;
    margin:     0;
    display:    flex;
    flex-direction: column;
    gap:        var(--space-5);
  }

  .contact-info__item {
    display:     flex;
    align-items: flex-start;
    gap:         var(--space-4);
  }

  .contact-info__icon {
    flex-shrink: 0;
    width:       40px;
    height:      40px;
    border-radius: var(--radius-md);
    background:    var(--color-secondary-light);
    color:         var(--color-secondary-hover);
    display:       flex;
    align-items:   center;
    justify-content: center;
  }

  .contact-info__label {
    font-family: var(--font-body);
    font-size:   var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color:       var(--color-text-muted);
    margin:      0 0 var(--space-1);
  }

  .contact-info__value {
    font-size:   var(--text-base);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0;
  }

  .contact-info__value a {
    color:           var(--color-primary);
    text-decoration: none;
    transition:      color var(--transition-base);
  }

  .contact-info__value a:hover {
    color: var(--color-secondary);
  }

  .visually-hidden {
    position: absolute;
    width:    1px;
    height:   1px;
    padding:  0;
    margin:   -1px;
    overflow: hidden;
    clip:     rect(0, 0, 0, 0);
    white-space: nowrap;
    border:   0;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-info {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .page-hero__title    { font-size: var(--text-4xl); }
    .contact-section     { padding-block: var(--space-16); }
  }

  @media (max-width: 480px) {
    .page-hero__title { font-size: var(--text-3xl); }
  }

  /* ── Map section ───────────────────────────────────────── */
  .map-section {
    background-color: var(--color-bg);
    padding-block:    var(--space-16);
  }

  .map-section__header {
    text-align:    center;
    margin-bottom: var(--space-8);
  }

  .map-section__eyebrow {
    display:        inline-block;
    font-family:    var(--font-body);
    font-size:      var(--text-xs);
    font-weight:    var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--color-secondary-hover);
    margin-bottom:  var(--space-3);
  }

  .map-section__title {
    font-family:  var(--font-heading);
    font-weight:  var(--font-weight-bold);
    font-size:    var(--text-3xl);
    color:        var(--color-primary);
    line-height:  var(--leading-tight);
    margin:       0;
  }

  .map-section__map-wrap {
    border-radius: var(--radius-lg);
    overflow:      hidden;
    border:        1px solid var(--color-border-light);
    box-shadow:    var(--shadow-md);
    line-height:   0;
  }

  .map-section__iframe {
    width:   100%;
    height:  420px;
    border:  none;
    display: block;
  }

  .map-section__cta {
    display:         flex;
    justify-content: center;
    margin-top:      var(--space-6);
  }

  .map-section__directions-btn {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-2);
    padding:         var(--space-3) var(--space-6);
    background:      var(--color-primary);
    color:           var(--color-white);
    border-radius:   var(--radius-full);
    font-family:     var(--font-body);
    font-size:       var(--text-sm);
    font-weight:     var(--font-weight-semibold);
    text-decoration: none;
    transition:
      background    var(--transition-base),
      transform     var(--transition-base),
      box-shadow    var(--transition-base);
  }

  .map-section__directions-btn:hover {
    background:  var(--color-primary-hover);
    transform:   translateY(-2px);
    box-shadow:  var(--shadow-hover);
  }

  @media (max-width: 768px) {
    .map-section { padding-block: var(--space-12); }
    .map-section__iframe { height: 300px; }
    .map-section__title { font-size: var(--text-2xl); }
  }
</style>
