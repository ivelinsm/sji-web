---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import ProductCard from '../components/ProductCard.astro';
import HaccpBadge from '../components/HaccpBadge.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/utils';
import { Image } from 'astro:assets';

import heroBottle from '../assets/aqua-viva-bottle.webp';
import qualityPhoto from '../assets/phase5.webp';

const lang = 'bg';
const base = import.meta.env.BASE_URL;

const featured = (await getCollection('products', (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const proofs = [
  { valueKey: 'home.proof.years.value',  labelKey: 'home.proof.years.label',  bodyKey: 'home.proof.years.body',  href: `${base}about` },
  { valueKey: 'home.proof.params.value', labelKey: 'home.proof.params.label', bodyKey: 'home.proof.params.body', href: `${base}kachestvo#lab` },
  { valueKey: 'home.proof.haccp.value',  labelKey: 'home.proof.haccp.label',  bodyKey: 'home.proof.haccp.body',  href: `${base}kachestvo` },
];
---

<Layout title={t(lang, 'meta.title')} description={t(lang, 'meta.description')}>

  <SiteHeader slot="header" lang={lang} />

  <!-- ── Hero: one claim, one bottle, daylight ──────────────── -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <Badge variant="secondary">
          <span data-i18n="hero.badge">{t(lang, 'hero.badge')}</span>
        </Badge>

        <h1 class="hero__title">
          <span data-i18n="hero.title">{t(lang, 'hero.title')}</span>
        </h1>

        <p class="hero__subtitle">
          <span data-i18n="hero.description">{t(lang, 'hero.description')}</span>
        </p>

        <div class="hero__cta">
          <Button variant="primary" size="lg" href={`${base}uslugi`}>
            <span data-i18n="nav.cta.order">{t(lang, 'nav.cta.order')}</span>
          </Button>
          <Button variant="ghost" size="lg" href={`${base}b2b`}>
            <span data-i18n="hero.cta.forbusiness">{t(lang, 'hero.cta.forbusiness')}</span>
          </Button>
        </div>

        <p class="hero__kicker">
          <span data-i18n="hero.kicker">{t(lang, 'hero.kicker')}</span>
        </p>
      </div>

      <div class="hero__media">
        <Image
          src={heroBottle}
          alt="Бутилка Aqua Viva 1.5 л на дневна светлина"
          widths={[480, 720, 1073]}
          sizes="(max-width: 900px) 92vw, 520px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ── Proof bar: three verifiable claims ─────────────────── -->
  <section class="proof">
    <div class="container">
      <div class="proof__grid">
        {proofs.map((p) => (
          <a href={p.href} class="proof__item">
            <span class="proof__value" data-i18n={p.valueKey}>{t(lang, p.valueKey)}</span>
            <span class="proof__label" data-i18n={p.labelKey}>{t(lang, p.labelKey)}</span>
            <span class="proof__body" data-i18n={p.bodyKey}>{t(lang, p.bodyKey)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Two paths: home/office vs business ─────────────────── -->
  <section class="paths">
    <div class="container">
      <h2 class="paths__title">
        <span data-i18n="home.paths.title">{t(lang, 'home.paths.title')}</span>
      </h2>

      <div class="paths__grid">
        <article class="path-card">
          <h3 class="path-card__title">
            <span data-i18n="home.paths.home.title">{t(lang, 'home.paths.home.title')}</span>
          </h3>
          <p class="path-card__body">
            <span data-i18n="home.paths.home.body">{t(lang, 'home.paths.home.body')}</span>
          </p>
          <ul class="path-card__list" role="list">
            {[1, 2, 3].map((n) => (
              <li>
                <span class="path-card__check" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 18 18" fill="none">
                    <path d="M4 9.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span data-i18n={`home.paths.home.item${n}`}>{t(lang, `home.paths.home.item${n}`)}</span>
              </li>
            ))}
          </ul>
          <Button variant="primary" href={`${base}uslugi`}>
            <span data-i18n="home.paths.home.cta">{t(lang, 'home.paths.home.cta')}</span>
          </Button>
        </article>

        <article class="path-card path-card--business">
          <h3 class="path-card__title">
            <span data-i18n="home.paths.business.title">{t(lang, 'home.paths.business.title')}</span>
          </h3>
          <p class="path-card__body">
            <span data-i18n="home.paths.business.body">{t(lang, 'home.paths.business.body')}</span>
          </p>
          <ul class="path-card__list" role="list">
            {[1, 2, 3].map((n) => (
              <li>
                <span class="path-card__check" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 18 18" fill="none">
                    <path d="M4 9.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span data-i18n={`home.paths.business.item${n}`}>{t(lang, `home.paths.business.item${n}`)}</span>
              </li>
            ))}
          </ul>
          <Button variant="ghost-white" href={`${base}b2b`}>
            <span data-i18n="home.paths.business.cta">{t(lang, 'home.paths.business.cta')}</span>
          </Button>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Featured products ──────────────────────────────────── -->
  <section class="featured">
    <div class="container">
      <header class="featured__header">
        <span class="eyebrow" data-i18n="home.featured.eyebrow">{t(lang, 'home.featured.eyebrow')}</span>
        <h2 class="featured__title">
          <span data-i18n="home.featured.title">{t(lang, 'home.featured.title')}</span>
        </h2>
        <p class="featured__subtitle">
          <span data-i18n="home.featured.subtitle">{t(lang, 'home.featured.subtitle')}</span>
        </p>
      </header>

      <div class="featured__grid">
        {featured.map((p) => (
          <ProductCard product={p} lang={lang} />
        ))}
      </div>

      <div class="featured__cta">
        <Button variant="ghost" href={`${base}products`}>
          <span data-i18n="home.featured.cta">{t(lang, 'home.featured.cta')}</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- ── Quality teaser ─────────────────────────────────────── -->
  <section class="quality">
    <div class="container quality__inner">
      <div class="quality__media">
        <Image
          src={qualityPhoto}
          alt=""
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="lazy"
        />
      </div>
      <div class="quality__text">
        <span class="eyebrow" data-i18n="home.quality.eyebrow">{t(lang, 'home.quality.eyebrow')}</span>
        <h2 class="quality__title">
          <span data-i18n="home.quality.title">{t(lang, 'home.quality.title')}</span>
        </h2>
        <p class="quality__body">
          <span data-i18n="home.quality.body">{t(lang, 'home.quality.body')}</span>
        </p>
        <div class="quality__row">
          <Button variant="primary" href={`${base}kachestvo`}>
            <span data-i18n="home.quality.cta">{t(lang, 'home.quality.cta')}</span>
          </Button>
          <HaccpBadge lang={lang} size="sm" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Private label teaser ───────────────────────────────── -->
  <section class="label-teaser">
    <div class="container label-teaser__inner">
      <div class="label-teaser__text">
        <span class="eyebrow" data-i18n="home.label.eyebrow">{t(lang, 'home.label.eyebrow')}</span>
        <h2 class="label-teaser__title">
          <span data-i18n="home.label.title">{t(lang, 'home.label.title')}</span>
        </h2>
        <p class="label-teaser__body">
          <span data-i18n="home.label.body">{t(lang, 'home.label.body')}</span>
        </p>
      </div>
      <Button variant="ghost" href={`${base}b2b#label`}>
        <span data-i18n="home.label.cta">{t(lang, 'home.label.cta')}</span>
      </Button>
    </div>
  </section>

  <!-- ── Closing CTA ────────────────────────────────────────── -->
  <section class="closing">
    <div class="container closing__inner">
      <h2 class="closing__title">
        <span data-i18n="home.cta.title">{t(lang, 'home.cta.title')}</span>
      </h2>
      <p class="closing__body">
        <span data-i18n="home.cta.body">{t(lang, 'home.cta.body')}</span>
      </p>
      <div class="closing__actions">
        <Button variant="primary" size="lg" href={`${base}uslugi`}>
          <span data-i18n="nav.cta.order">{t(lang, 'nav.cta.order')}</span>
        </Button>
        <Button variant="ghost" size="lg" href={`${base}contact`}>
          <span data-i18n="home.cta.secondary">{t(lang, 'home.cta.secondary')}</span>
        </Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />

</Layout>

<style>
  .eyebrow {
    display:        inline-block;
    font-size:      var(--text-xs);
    font-weight:    var(--font-weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color:          var(--color-secondary-hover);
    margin-bottom:  var(--space-3);
  }

  /* ── Hero ───────────────────────────────────────────────── */
  .hero {
    background: linear-gradient(180deg, var(--color-tint) 0%, var(--color-bg) 100%);
    overflow:   hidden;
  }

  .hero__inner {
    display:               grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap:                   var(--space-16);
    align-items:           center;
    padding-block:         var(--space-16) var(--space-20);
  }

  .hero__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-6xl);
    line-height:    var(--leading-none);
    letter-spacing: -0.02em;
    color:          var(--color-primary);
    margin:         var(--space-5) 0 0;
    max-width:      14ch;
  }

  .hero__subtitle {
    font-size:   var(--text-xl);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin-top:  var(--space-5);
    max-width:   52ch;
  }

  .hero__cta {
    display:    flex;
    flex-wrap:  wrap;
    gap:        var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__kicker {
    margin-top:     var(--space-8);
    padding-top:    var(--space-5);
    border-top:     1px solid var(--color-border-light);
    font-size:      var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color:          var(--color-text-muted);
    font-weight:    var(--font-weight-medium);
  }

  .hero__media {
    justify-self: center;
  }

  .hero__media :global(img) {
    width:         100%;
    max-width:     440px;
    height:        auto;
    border-radius: var(--radius-2xl);
    box-shadow:    0 24px 64px rgba(18, 37, 74, 0.16);
    display:       block;
  }

  /* ── Proof bar ──────────────────────────────────────────── */
  .proof {
    background:    var(--color-surface);
    border-block:  1px solid var(--color-border-light);
    padding-block: var(--space-12);
  }

  .proof__grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-10);
  }

  .proof__item {
    display:         block;
    text-decoration: none;
    padding-left:    var(--space-5);
    border-left:     2px solid var(--color-secondary);
  }

  .proof__value {
    display:        block;
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    line-height:    var(--leading-none);
    letter-spacing: -0.02em;
    color:          var(--color-primary);
  }

  .proof__label {
    display:     block;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size:   var(--text-base);
    color:       var(--color-text);
    margin-top:  var(--space-2);
  }

  .proof__body {
    display:     block;
    font-size:   var(--text-sm);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-top:  var(--space-2);
  }

  .proof__item:hover .proof__value {
    color: var(--color-secondary-hover);
  }

  /* ── Paths ──────────────────────────────────────────────── */
  .paths {
    background:    var(--color-bg);
    padding-block: var(--space-20);
  }

  .paths__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-10);
  }

  .paths__grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   var(--space-6);
  }

  .path-card {
    background:    var(--color-surface);
    border:        1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    padding:       var(--space-10);
    display:       flex;
    flex-direction: column;
    align-items:   flex-start;
  }

  .path-card--business {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .path-card__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-2xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    margin:         0 0 var(--space-3);
  }

  .path-card--business .path-card__title {
    color: var(--color-white);
  }

  .path-card__body {
    font-size:   var(--text-base);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0 0 var(--space-6);
  }

  .path-card--business .path-card__body {
    color: rgba(255, 255, 255, 0.82);
  }

  .path-card__list {
    list-style:     none;
    margin:         0 0 var(--space-8);
    padding:        0;
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
    flex:           1;
  }

  .path-card__list li {
    display:     flex;
    align-items: flex-start;
    gap:         var(--space-3);
    font-size:   var(--text-sm);
    color:       var(--color-text);
  }

  .path-card--business .path-card__list li {
    color: rgba(255, 255, 255, 0.88);
  }

  .path-card__check {
    flex-shrink:     0;
    width:           20px;
    height:          20px;
    border-radius:   var(--radius-full);
    background:      var(--color-secondary-light);
    color:           var(--color-secondary-hover);
    display:         inline-flex;
    align-items:     center;
    justify-content: center;
    margin-top:      1px;
  }

  .path-card--business .path-card__check {
    background: rgba(255, 255, 255, 0.14);
    color:      var(--color-secondary);
  }

  /* ── Featured products ──────────────────────────────────── */
  .featured {
    background:    var(--color-surface);
    padding-block: var(--space-20);
  }

  .featured__header {
    max-width:     640px;
    margin-bottom: var(--space-10);
  }

  .featured__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-3);
  }

  .featured__subtitle {
    font-size:   var(--text-lg);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      0;
  }

  .featured__grid {
    display:               grid;
    grid-template-columns: repeat(4, 1fr);
    gap:                   var(--space-6);
  }

  .featured__cta {
    margin-top: var(--space-10);
    text-align: center;
  }

  /* ── Quality teaser ─────────────────────────────────────── */
  .quality {
    background:    var(--color-bg);
    padding-block: var(--space-20);
  }

  .quality__inner {
    display:               grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap:                   var(--space-16);
    align-items:           center;
  }

  .quality__media {
    border-radius: var(--radius-2xl);
    overflow:      hidden;
    aspect-ratio:  4 / 3;
    background:    var(--color-tint);
  }

  .quality__media :global(img) {
    width:      100%;
    height:     100%;
    object-fit: cover;
    display:    block;
  }

  .quality__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-4);
  }

  .quality__body {
    font-size:   var(--text-lg);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0 0 var(--space-8);
    max-width:   56ch;
  }

  .quality__row {
    display:     flex;
    align-items: center;
    flex-wrap:   wrap;
    gap:         var(--space-5);
  }

  /* ── Private label teaser ───────────────────────────────── */
  .label-teaser {
    background:    var(--color-surface);
    border-top:    1px solid var(--color-border-light);
    padding-block: var(--space-16);
  }

  .label-teaser__inner {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             var(--space-10);
  }

  .label-teaser__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-3xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-3);
  }

  .label-teaser__body {
    font-size:   var(--text-base);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      0;
    max-width:   58ch;
  }

  /* ── Closing ────────────────────────────────────────────── */
  .closing {
    background:    linear-gradient(180deg, var(--color-bg) 0%, var(--color-tint) 100%);
    padding-block: var(--space-24);
  }

  .closing__inner {
    text-align: center;
    max-width:  640px;
  }

  .closing__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-5xl);
    color:          var(--color-primary);
    line-height:    var(--leading-none);
    letter-spacing: -0.015em;
    margin:         0 0 var(--space-5);
  }

  .closing__body {
    font-size:   var(--text-lg);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0 0 var(--space-8);
  }

  .closing__actions {
    display:         flex;
    justify-content: center;
    flex-wrap:       wrap;
    gap:             var(--space-4);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .featured__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      padding-block: var(--space-10) var(--space-16);
    }

    .hero__media { order: -1; }
    .hero__media :global(img) { max-width: 320px; }

    .quality__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .paths,
    .featured,
    .quality { padding-block: var(--space-16); }

    .paths__grid { grid-template-columns: 1fr; }
    .featured__grid { grid-template-columns: 1fr; }

    .label-teaser__inner {
      flex-direction: column;
      align-items:    flex-start;
    }

    .closing { padding-block: var(--space-16); }
  }

  @media (max-width: 480px) {
    .hero__cta { flex-direction: column; align-items: stretch; }
    .hero__cta :global(.btn) { width: 100%; justify-content: center; }

    .closing__actions { flex-direction: column; align-items: stretch; }
    .closing__actions :global(.btn) { width: 100%; }
  }
</style>
