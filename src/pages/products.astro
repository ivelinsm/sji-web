---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Heading from '../components/Heading.astro';
import Navbar from '../components/Navbar.astro';
import NavLink from '../components/NavLink.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import Badge from '../components/Badge.astro';
import { t } from '../i18n/utils';
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.webp';
import bottlesRaw from '../assets/all.webp';
import aquaVivaImg from '../assets/aqua-viva.webp';
import izvorImg from '../assets/izvor.webp';
import nasladaImg from '../assets/naslada.webp';
import santosIceTeaImg from '../assets/santos-ice-tea.webp';
import petBottlesImg from '../assets/pet-bottles.webp';

const lang = 'bg';
const base = import.meta.env.BASE_URL;
const bottlesImg = await getImage({ src: bottlesRaw });
---

<Layout title={t(lang, 'products.page.title')} description={t(lang, 'products.page.description')}>

  <!-- ── Navbar ─────────────────────────────────────────────── -->
  <Navbar slot="header" variant="transparent">
    <Image slot="logo" src={logo} alt="SJI" class="nav-logo" />
    <NavLink slot="links" href={base}><span data-i18n="nav.home">{t(lang, 'nav.home')}</span></NavLink>
    <NavLink slot="links" href={`${base}products`}><span data-i18n="nav.products">{t(lang, 'nav.products')}</span></NavLink>
    <NavLink slot="links" href={`${base}about`}><span data-i18n="nav.about">{t(lang, 'nav.about')}</span></NavLink>
    <NavLink slot="links" href={`${base}contact`}><span data-i18n="nav.contact">{t(lang, 'nav.contact')}</span></NavLink>
    <Button slot="actions" variant="ghost-white" href={`${base}contact`} size="sm">
      <span data-i18n="nav.cta.enquiry">{t(lang, 'nav.cta.enquiry')}</span>
    </Button>
    <LangSwitcher slot="actions" />
  </Navbar>

  <!-- ── Page hero ──────────────────────────────────────────── -->
  <div class="page-hero" style={`background-image: linear-gradient(rgba(10,20,55,0.62), rgba(10,20,55,0.72)), url(${bottlesImg.src})`}>
    <div class="container">
      <div class="page-hero__inner">
        <Badge variant="secondary">
          <span data-i18n="products.page.hero.eyebrow">{t(lang, 'products.page.hero.eyebrow')}</span>
        </Badge>
        <h1 class="page-hero__title">
          <span data-i18n="products.page.hero.title">{t(lang, 'products.page.hero.title')}</span>
        </h1>
        <p class="page-hero__subtitle">
          <span data-i18n="products.page.hero.subtitle">{t(lang, 'products.page.hero.subtitle')}</span>
        </p>

        <!-- Category quick-nav pills -->
        <nav class="page-hero__nav" aria-label="Product categories">
          <a href="#waters" class="pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 2C12 2 5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            </svg>
            <span data-i18n="products.nav.waters">{t(lang, 'products.nav.waters')}</span>
          </a>
          <a href="#drinks" class="pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M8 2h8l1 6H7L8 2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M7 8c0 8 2 12 5 12s5-4 5-12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="10" cy="13" r="1" fill="currentColor"/>
              <circle cx="14" cy="10" r="1" fill="currentColor"/>
            </svg>
            <span data-i18n="products.nav.drinks">{t(lang, 'products.nav.drinks')}</span>
          </a>
          <a href="#concentrates" class="pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="8" y="3" width="8" height="18" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <path d="M10 3V1M14 3V1" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <path d="M10 10h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span data-i18n="products.nav.concentrates">{t(lang, 'products.nav.concentrates')}</span>
          </a>
          <a href="#b2b" class="pill pill--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <path d="M8 7V5a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
            <span data-i18n="products.nav.b2b">{t(lang, 'products.nav.b2b')}</span>
          </a>
        </nav>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- SECTION: Waters                                         -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section id="waters" class="cat-section cat-section--gray">
    <div class="container">

      <div class="cat-header">
        <div class="cat-header__icon cat-header__icon--blue">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2C12 2 5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <h2 class="cat-header__title">
            <span data-i18n="products.section.waters">{t(lang, 'products.section.waters')}</span>
          </h2>
          <p class="cat-header__desc">
            <span data-i18n="products.section.waters.desc">{t(lang, 'products.section.waters.desc')}</span>
          </p>
        </div>
      </div>

      <div class="products-grid">

        <!-- Aqua Viva -->
        <div class="product-card product-card--has-photo">
          <div class="product-card__img">
            <Image src={aquaVivaImg} alt="Aqua Viva натурална минерална вода" />
          </div>
          <div class="product-card__top">
            <span class="product-icon product-icon--blue">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2C12 2 5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                <path d="M9 17a3 3 0 0 0 4 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <Badge variant="secondary">
              <span data-i18n="products.badge.still">{t(lang, 'products.badge.still')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.aquaviva.name">{t(lang, 'products.aquaviva.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.aquaviva.desc">{t(lang, 'products.aquaviva.desc')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.aquaviva.sizes">{t(lang, 'products.aquaviva.sizes')}</span>
          </p>
        </div>

        <!-- Izvor Still -->
        <div class="product-card product-card--has-photo">
          <div class="product-card__img">
            <Image src={izvorImg} alt="Извор натурална изворна вода" />
          </div>
          <div class="product-card__top">
            <span class="product-icon product-icon--blue">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2C12 2 5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                <path d="M8 12c1-1.5 2-2 4-1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <Badge variant="secondary">
              <span data-i18n="products.badge.still">{t(lang, 'products.badge.still')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.izvor.still.name">{t(lang, 'products.izvor.still.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.izvor.still.desc">{t(lang, 'products.izvor.still.desc')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.izvor.still.sizes">{t(lang, 'products.izvor.still.sizes')}</span>
          </p>
        </div>

        <!-- Santos Sparkling -->
        <div class="product-card">
          <div class="product-card__visual product-card__visual--teal">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M8 2h8l1 6H7L8 2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M7 8c0 8 2 12 5 12s5-4 5-12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="10" cy="13" r="1" fill="currentColor"/>
              <circle cx="14" cy="11" r="1" fill="currentColor"/>
              <circle cx="11" cy="16" r="0.75" fill="currentColor"/>
            </svg>
          </div>
          <div class="product-card__top">
            <Badge variant="primary">
              <span data-i18n="products.badge.sparkling">{t(lang, 'products.badge.sparkling')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.santos.soda.name">{t(lang, 'products.santos.soda.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.santos.soda.desc">{t(lang, 'products.santos.soda.desc')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.santos.soda.sizes">{t(lang, 'products.santos.soda.sizes')}</span>
          </p>
        </div>

        <!-- Santos Sparkling Lemon -->
        <div class="product-card">
          <div class="product-card__visual product-card__visual--teal">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.75"/>
              <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="product-card__top">
            <Badge variant="primary">
              <span data-i18n="products.badge.sparkling">{t(lang, 'products.badge.sparkling')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.santos.soda.lemon.name">{t(lang, 'products.santos.soda.lemon.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.santos.soda.lemon.desc">{t(lang, 'products.santos.soda.lemon.desc')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.santos.soda.lemon.sizes">{t(lang, 'products.santos.soda.lemon.sizes')}</span>
          </p>
        </div>

        <!-- Izvor Sparkling -->
        <div class="product-card product-card--has-photo">
          <div class="product-card__img">
            <Image src={izvorImg} alt="Извор газирана изворна вода" />
          </div>
          <div class="product-card__top">
            <span class="product-icon product-icon--teal">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M8 2h8l1 6H7L8 2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                <path d="M7 8c0 8 2 12 5 12s5-4 5-12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                <circle cx="12" cy="12" r="1" fill="currentColor"/>
                <circle cx="10" cy="15" r="0.75" fill="currentColor"/>
              </svg>
            </span>
            <Badge variant="primary">
              <span data-i18n="products.badge.sparkling">{t(lang, 'products.badge.sparkling')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.izvor.sparkling.name">{t(lang, 'products.izvor.sparkling.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.izvor.sparkling.desc">{t(lang, 'products.izvor.sparkling.desc')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.izvor.sparkling.sizes">{t(lang, 'products.izvor.sparkling.sizes')}</span>
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- SECTION: Drinks                                         -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section id="drinks" class="cat-section cat-section--white">
    <div class="container">

      <div class="cat-header">
        <div class="cat-header__icon cat-header__icon--aqua">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8 2h8l1 6H7L8 2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M7 8c0 8 2 12 5 12s5-4 5-12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            <circle cx="10" cy="13" r="1" fill="currentColor"/>
            <circle cx="14" cy="10" r="1" fill="currentColor"/>
          </svg>
        </div>
        <div>
          <h2 class="cat-header__title">
            <span data-i18n="products.section.drinks">{t(lang, 'products.section.drinks')}</span>
          </h2>
          <p class="cat-header__desc">
            <span data-i18n="products.section.drinks.desc">{t(lang, 'products.section.drinks.desc')}</span>
          </p>
        </div>
      </div>

      <div class="products-grid">

        <!-- Santos Drinks Series -->
        <div class="product-card product-card--featured">
          <div class="product-card__visual product-card__visual--aqua">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M8 2h8l1 6H7L8 2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M7 8c0 8 2 12 5 12s5-4 5-12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="10" cy="13" r="1" fill="currentColor"/>
              <circle cx="14" cy="10" r="1" fill="currentColor"/>
              <circle cx="11.5" cy="16.5" r="0.75" fill="currentColor"/>
            </svg>
          </div>
          <div class="product-card__top">
            <Badge variant="secondary">
              <span data-i18n="products.badge.drinks">{t(lang, 'products.badge.drinks')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.santos.drinks.name">{t(lang, 'products.santos.drinks.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.santos.drinks.desc">{t(lang, 'products.santos.drinks.desc')}</span>
          </p>
          <p class="product-card__flavors">
            <span data-i18n="products.santos.drinks.flavors">{t(lang, 'products.santos.drinks.flavors')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.santos.drinks.sizes">{t(lang, 'products.santos.drinks.sizes')}</span>
          </p>
        </div>

        <!-- Naslada -->
        <div class="product-card product-card--has-photo">
          <div class="product-card__img">
            <Image src={nasladaImg} alt="Наслада плодова напитка" />
          </div>
          <div class="product-card__top">
            <span class="product-icon product-icon--aqua">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="7" y="3" width="10" height="18" rx="2" stroke="currentColor" stroke-width="1.75"/>
                <path d="M10 7h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M9 14c1-1 2-1.5 3-1s2 1 3 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <Badge variant="secondary">
              <span data-i18n="products.badge.drinks">{t(lang, 'products.badge.drinks')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.naslada.name">{t(lang, 'products.naslada.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.naslada.desc">{t(lang, 'products.naslada.desc')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.naslada.sizes">{t(lang, 'products.naslada.sizes')}</span>
          </p>
        </div>

        <!-- Ice Tea -->
        <div class="product-card product-card--featured product-card--has-photo">
          <div class="product-card__img">
            <Image src={santosIceTeaImg} alt="Santos студен чай" />
          </div>
          <div class="product-card__top">
            <span class="product-icon product-icon--green">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 4c2 0 4 2 6 2s4-2 6-2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                <path d="M7 8h10l-1 10H8L7 8z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                <path d="M10 13c0 1.5 4 1.5 4 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
            <Badge variant="secondary">
              <span data-i18n="products.badge.tea">{t(lang, 'products.badge.tea')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.santos.icetea.name">{t(lang, 'products.santos.icetea.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.santos.icetea.desc">{t(lang, 'products.santos.icetea.desc')}</span>
          </p>
          <p class="product-card__flavors">
            <span data-i18n="products.santos.icetea.flavors">{t(lang, 'products.santos.icetea.flavors')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.santos.icetea.sizes">{t(lang, 'products.santos.icetea.sizes')}</span>
          </p>
        </div>

        <!-- Homestyle Lemonade -->
        <div class="product-card">
          <div class="product-card__visual product-card__visual--yellow">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.75"/>
              <path d="M9 9c.5-1 1.5-2 3-2s2.5 1 2.5 2.5c0 2-2 3-3 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="12" cy="17" r="0.75" fill="currentColor"/>
            </svg>
          </div>
          <div class="product-card__top">
            <Badge variant="secondary">
              <span data-i18n="products.badge.lemonade">{t(lang, 'products.badge.lemonade')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.lemonade.name">{t(lang, 'products.lemonade.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.lemonade.desc">{t(lang, 'products.lemonade.desc')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.lemonade.sizes">{t(lang, 'products.lemonade.sizes')}</span>
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- SECTION: Concentrates & Other                           -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <section id="concentrates" class="cat-section cat-section--gray">
    <div class="container">

      <div class="cat-header">
        <div class="cat-header__icon cat-header__icon--neutral">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="8" y="3" width="8" height="18" rx="2" stroke="currentColor" stroke-width="1.75"/>
            <path d="M10 3V2M14 3V2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            <path d="M10 9h4M10 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h2 class="cat-header__title">
            <span data-i18n="products.section.concentrates">{t(lang, 'products.section.concentrates')}</span>
          </h2>
          <p class="cat-header__desc">
            <span data-i18n="products.section.concentrates.desc">{t(lang, 'products.section.concentrates.desc')}</span>
          </p>
        </div>
      </div>

      <div class="products-grid">

        <!-- Jumbo Concentrate -->
        <div class="product-card">
          <div class="product-card__visual product-card__visual--aqua">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="8" y="4" width="8" height="16" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <path d="M10 4V2M14 4V2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M10 10h4M10 14h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="product-card__top">
            <Badge variant="secondary">
              <span data-i18n="products.badge.concentrate">{t(lang, 'products.badge.concentrate')}</span>
            </Badge>
          </div>
          <h3 class="product-card__name">
            <span data-i18n="products.jumbo.name">{t(lang, 'products.jumbo.name')}</span>
          </h3>
          <p class="product-card__desc">
            <span data-i18n="products.jumbo.desc">{t(lang, 'products.jumbo.desc')}</span>
          </p>
          <p class="product-card__sizes">
            <span data-i18n="products.jumbo.sizes">{t(lang, 'products.jumbo.sizes')}</span>
          </p>
          <p class="product-card__note">
            <span data-i18n="products.jumbo.sizes.b2b">{t(lang, 'products.jumbo.sizes.b2b')}</span>
          </p>
        </div>

        <!-- Slushy -->
        <div class="product-card product-card--b2b">
