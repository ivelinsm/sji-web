---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/utils';

const lang = 'bg';
const base = import.meta.env.BASE_URL;

const all = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const sections = [
  { id: 'waters',       titleKey: 'products.section.waters',       descKey: 'products.section.waters.desc',       bg: 'bg' },
  { id: 'drinks',       titleKey: 'products.section.drinks',       descKey: 'products.section.drinks.desc',       bg: 'surface' },
  { id: 'concentrates', titleKey: 'products.section.concentrates', descKey: 'products.section.concentrates.desc', bg: 'bg' },
] as const;
---

<Layout
  title={t(lang, 'products.page.title')}
  description={t(lang, 'products.page.description')}
  titleKey="products.page.title"
  descriptionKey="products.page.description"
>

  <SiteHeader slot="header" lang={lang} />

  <PageHero
    lang={lang}
    eyebrowKey="products.page.hero.eyebrow"
    titleKey="products.page.hero.title"
    subtitleKey="products.page.hero.subtitle"
  >
    <nav slot="extra" class="cat-nav" aria-label={t(lang, 'products.page.hero.eyebrow')}>
      {sections.map((s) => (
        <a href={`#${s.id}`} class="cat-nav__pill">
          <span data-i18n={s.titleKey}>{t(lang, s.titleKey)}</span>
        </a>
      ))}
      <a href={`${base}b2b`} class="cat-nav__pill cat-nav__pill--primary">
        <span data-i18n="nav.b2b">{t(lang, 'nav.b2b')}</span>
      </a>
    </nav>
  </PageHero>

  {sections.map((s) => (
    <section id={s.id} class:list={['cat-section', `cat-section--${s.bg}`]}>
      <div class="container">
        <header class="cat-header">
          <h2 class="cat-header__title">
            <span data-i18n={s.titleKey}>{t(lang, s.titleKey)}</span>
          </h2>
          <p class="cat-header__desc">
            <span data-i18n={s.descKey}>{t(lang, s.descKey)}</span>
          </p>
        </header>

        <div class="products-grid">
          {all
            .filter((p) => p.data.category === s.id)
            .map((p) => (
              <ProductCard product={p} lang={lang} />
            ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ── Closing paths band ─────────────────────────────────── -->
  <section class="closing-band">
    <div class="container closing-band__inner">
      <h2 class="closing-band__title">
        <span data-i18n="home.cta.title">{t(lang, 'home.cta.title')}</span>
      </h2>
      <p class="closing-band__body">
        <span data-i18n="home.cta.body">{t(lang, 'home.cta.body')}</span>
      </p>
      <div class="closing-band__actions">
        <Button variant="primary" href={`${base}uslugi`}>
          <span data-i18n="nav.cta.order">{t(lang, 'nav.cta.order')}</span>
        </Button>
        <Button variant="ghost" href={`${base}b2b`}>
          <span data-i18n="nav.b2b">{t(lang, 'nav.b2b')}</span>
        </Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />

</Layout>

<style>
  /* ── Category quick-nav pills (in hero) ─────────────────── */
  .cat-nav {
    display:    flex;
    flex-wrap:  wrap;
    gap:        var(--space-3);
    margin-top: var(--space-8);
  }

  .cat-nav__pill {
    display:         inline-flex;
    align-items:     center;
    padding:         var(--space-2) var(--space-4);
    background:      var(--color-surface);
    border:          1px solid var(--color-border-light);
    border-radius:   var(--radius-full);
    font-size:       var(--text-sm);
    font-weight:     var(--font-weight-medium);
    color:           var(--color-text);
    text-decoration: none;
    transition:
      border-color var(--transition-base),
      color        var(--transition-base),
      box-shadow   var(--transition-base);
  }

  .cat-nav__pill:hover {
    border-color: var(--color-secondary);
    color:        var(--color-secondary-hover);
    box-shadow:   var(--shadow-sm);
  }

  .cat-nav__pill--primary {
    background:   var(--color-primary);
    border-color: var(--color-primary);
    color:        var(--color-white);
  }

  .cat-nav__pill--primary:hover {
    background:   var(--color-primary-hover);
    color:        var(--color-white);
  }

  /* ── Category sections ──────────────────────────────────── */
  .cat-section {
    padding-block: var(--space-20);
  }

  .cat-section--bg      { background-color: var(--color-bg); }
  .cat-section--surface { background-color: var(--color-surface); }

  .cat-header {
    max-width:     640px;
    margin-bottom: var(--space-10);
  }

  .cat-header__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-3xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-2);
  }

  .cat-header__desc {
    font-size:   var(--text-base);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      0;
  }

  .products-grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-6);
  }

  /* ── Closing band ───────────────────────────────────────── */
  .closing-band {
    background:    var(--color-surface);
    border-top:    1px solid var(--color-border-light);
    padding-block: var(--space-20);
  }

  .closing-band__inner {
    text-align: center;
    max-width:  620px;
  }

  .closing-band__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-4);
  }

  .closing-band__body {
    font-size:     var(--text-lg);
    color:         var(--color-text-muted);
    line-height:   var(--leading-relaxed);
    margin:        0 0 var(--space-8);
  }

  .closing-band__actions {
    display:         flex;
    justify-content: center;
    flex-wrap:       wrap;
    gap:             var(--space-4);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .cat-section { padding-block: var(--space-16); }
    .products-grid { grid-template-columns: 1fr; }
  }
</style>
