</Layout>

<style>
  /* ── Nav logo ──────────────────────────────────────────── */
  .nav-logo {
    height:     52px;
    width:      auto;
    display:    block;
    object-fit: contain;
  }

  /* ── Page hero ─────────────────────────────────────────── */
  .page-hero {
    background-color:    var(--color-primary);
    background-size:     cover;
    background-position: center;
    background-repeat:   no-repeat;
    margin-top:          -72px;
    padding-top:         calc(72px + var(--space-20));
    padding-bottom:      var(--space-12);
  }

  .page-hero__inner {
    max-width: 640px;
  }

  .page-hero__title {
    font-family:  var(--font-heading);
    font-weight:  var(--font-weight-bold);
    font-size:    var(--text-5xl);
    color:        var(--color-white);
    line-height:  var(--leading-tight);
    margin-top:   var(--space-4);
    margin-bottom: 0;
  }

  .page-hero__subtitle {
    font-size:   var(--text-lg);
    color:       rgba(255, 255, 255, 0.78);
    line-height: var(--leading-relaxed);
    margin-top:  var(--space-4);
  }

  /* ── Category quick-nav pills ──────────────────────────── */
  .page-hero__nav {
    display:    flex;
    flex-wrap:  wrap;
    gap:        var(--space-3);
    margin-top: var(--space-8);
  }

  .pill {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-2);
    padding:         var(--space-2) var(--space-4);
    background:      rgba(255, 255, 255, 0.12);
    border:          1px solid rgba(255, 255, 255, 0.25);
    border-radius:   var(--radius-full);
    font-family:     var(--font-body);
    font-size:       var(--text-sm);
    font-weight:     var(--font-weight-medium);
    color:           rgba(255, 255, 255, 0.88);
    text-decoration: none;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition:      background var(--transition-base), border-color var(--transition-base), color var(--transition-base);
  }

  .pill:hover {
    background:   rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.45);
    color:        var(--color-white);
  }

  .pill--primary {
    background:   rgba(39, 169, 216, 0.22);
    border-color: var(--color-secondary);
    color:        var(--color-white);
  }

  .pill--primary:hover {
    background:   rgba(39, 169, 216, 0.38);
    border-color: var(--color-secondary);
  }

  /* ── Product category sections ─────────────────────────── */
  .cat-section {
    padding-block: var(--space-20);
  }

  .cat-section--gray    { background-color: var(--color-bg); }
  .cat-section--white   { background-color: var(--color-surface); }

  /* ── Category header ───────────────────────────────────── */
  .cat-header {
    display:      flex;
    align-items:  flex-start;
    gap:          var(--space-5);
    margin-bottom: var(--space-12);
  }

  .cat-header__icon {
    flex-shrink: 0;
    width:       56px;
    height:      56px;
    border-radius: var(--radius-lg);
    display:     flex;
    align-items: center;
    justify-content: center;
  }

  .cat-header__icon--blue   { background: var(--color-primary-alpha-10); color: var(--color-primary); }
  .cat-header__icon--aqua   { background: var(--color-secondary-light);  color: var(--color-secondary-hover); }
  .cat-header__icon--neutral { background: var(--color-border-light);    color: var(--color-text-muted); }

  .cat-header__title {
    font-family:  var(--font-heading);
    font-weight:  var(--font-weight-bold);
    font-size:    var(--text-3xl);
    color:        var(--color-primary);
    line-height:  var(--leading-tight);
    margin:       0 0 var(--space-2);
  }

  .cat-header__desc {
    font-size:   var(--text-base);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      0;
  }

  /* ── Products grid ─────────────────────────────────────── */
  .products-grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-6);
  }

  /* ── Product card ──────────────────────────────────────── */
  .product-card {
    background:    var(--color-surface);
    border-radius: var(--radius-lg);
    border:        1px solid var(--color-border-light);
    padding:       var(--space-6);
    display:       flex;
    flex-direction: column;
    gap:           var(--space-3);
    transition:    box-shadow var(--transition-base), transform var(--transition-base), border-color var(--transition-base);
  }

  .product-card:hover {
    box-shadow:   var(--shadow-md);
    transform:    translateY(-2px);
    border-color: var(--color-secondary);
  }

  /* B2B-only cards get a subtle left border accent */
  .product-card--b2b {
    border-left: 3px solid var(--color-primary);
  }

  .product-card--featured {
    border-top: 3px solid var(--color-secondary);
  }

  .product-card__top {
    display:     flex;
    align-items: center;
    gap:         var(--space-3);
  }

  .product-card__name {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size:   var(--text-lg);
    color:       var(--color-primary);
    line-height: var(--leading-tight);
    margin:      0;
  }

  .product-card__desc {
    font-size:   var(--text-sm);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0;
    flex: 1;
  }

  .product-card__flavors {
    font-size:    var(--text-xs);
    color:        var(--color-secondary-hover);
    font-weight:  var(--font-weight-medium);
    background:   var(--color-secondary-light);
    padding:      var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    margin:       0;
    line-height:  var(--leading-normal);
  }

  .product-card__sizes {
    font-size:   var(--text-sm);
    color:       var(--color-text-muted);
    font-weight: var(--font-weight-medium);
    margin:      0;
  }

  .product-card__note {
    font-size:   var(--text-xs);
    color:       var(--color-primary);
    font-weight: var(--font-weight-medium);
    margin:      0;
  }

  /* ── Product card photo area ───────────────────────────────── */
  .product-card__img {
    width:         100%;
    height:        120px;
    border-radius: var(--radius-md);
    overflow:      hidden;
    flex-shrink:   0;
  }

  .product-card__img img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    display:    block;
  }

  .product-card__img--placeholder {
    background: linear-gradient(135deg, var(--color-primary-alpha-10) 0%, var(--color-secondary-light) 100%);
    display:    flex;
    align-items: center;
    justify-content: center;
    color:      var(--color-text-muted);
    border:     1px dashed var(--color-border-light);
  }

  /* ── Product card visual band (icon-only cards) ────────────── */
  .product-card__visual {
    width:         100%;
    height:        120px;
    border-radius: var(--radius-md);
    display:       flex;
    align-items:   center;
    justify-content: center;
    flex-shrink:   0;
  }

  .product-card__visual--blue    { background: var(--color-primary-alpha-10);       color: var(--color-primary); }
  .product-card__visual--teal    { background: var(--color-primary-alpha-10);       color: var(--color-primary); }
  .product-card__visual--aqua    { background: var(--color-secondary-light);        color: var(--color-secondary-hover); }
  .product-card__visual--green   { background: rgba(39, 169, 90, 0.10);            color: #1a7a3f; }
  .product-card__visual--yellow  { background: rgba(214, 170, 40, 0.12);           color: #9a6e00; }
  .product-card__visual--neutral { background: var(--color-border-light);          color: var(--color-text-muted); }

  /* ── Product icon ──────────────────────────────────────── */
  .product-icon {
    flex-shrink: 0;
    width:       40px;
    height:      40px;
    border-radius: var(--radius-md);
    display:     flex;
    align-items: center;
    justify-content: center;
  }

  .product-icon--blue   { background: var(--color-primary-alpha-10); color: var(--color-primary); }
  .product-icon--teal   { background: var(--color-primary-alpha-10); color: var(--color-primary); }
  .product-icon--aqua   { background: var(--color-secondary-light);  color: var(--color-secondary-hover); }
  .product-icon--green  { background: rgba(39, 169, 90, 0.10);       color: #1a7a3f; }
  .product-icon--yellow { background: rgba(214, 170, 40, 0.12);      color: #9a6e00; }
  .product-icon--neutral { background: var(--color-border-light);    color: var(--color-text-muted); }

  /* ── B2B section ───────────────────────────────────────── */
  .b2b-section {
    background-color: var(--color-primary);
    position:   relative;
    overflow:   hidden;
    padding-block: var(--space-24);
  }

  .b2b-section__bg {
    position:   absolute;
    inset:      0;
    background: radial-gradient(ellipse at 80% 50%, rgba(39, 169, 216, 0.18) 0%, transparent 70%),
                radial-gradient(ellipse at 10% 80%, rgba(255, 255, 255, 0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  .b2b-section__inner {
    position: relative;
    z-index:  1;
  }

  .b2b-header {
    text-align:    center;
    margin-bottom: var(--space-16);
  }

  .b2b-eyebrow {
    display:        inline-block;
    font-family:    var(--font-body);
    font-size:      var(--text-xs);
    font-weight:    var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--color-secondary);
    margin-bottom:  var(--space-4);
  }

  .b2b-title {
    font-family:  var(--font-heading);
    font-weight:  var(--font-weight-bold);
    font-size:    var(--text-4xl);
    color:        var(--color-white);
    line-height:  var(--leading-tight);
    margin:       0 0 var(--space-4);
  }

  .b2b-subtitle {
    font-size:   var(--text-lg);
    color:       rgba(255, 255, 255, 0.72);
    line-height: var(--leading-relaxed);
    max-width:   560px;
    margin:      0 auto;
  }

  .b2b-grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-6);
    margin-bottom:         var(--space-12);
  }

  .b2b-card {
    background:    rgba(255, 255, 255, 0.07);
    border:        1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding:       var(--space-8);
