---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import HaccpBadge from '../components/HaccpBadge.astro';
import { t } from '../i18n/utils';
import { Image } from 'astro:assets';

import machine2 from '../assets/machine-2.webp';
import machine3 from '../assets/machine-3.webp';

const lang = 'bg';
const base = import.meta.env.BASE_URL;

const timeline = [
  { labelKey: 'about.timeline.2000.label',  titleKey: 'about.timeline.2000.title',  bodyKey: 'about.timeline.2000.body' },
  { labelKey: 'about.timeline.2012.label',  titleKey: 'about.timeline.2012.title',  bodyKey: 'about.timeline.2012.body' },
  { labelKey: 'about.timeline.today.label', titleKey: 'about.timeline.today.title', bodyKey: 'about.timeline.today.body', now: true },
];

const stats = [1, 2, 3].map((n) => ({
  valueKey: `about.science.stat${n}.value`,
  labelKey: `about.science.stat${n}.label`,
  bodyKey: `about.science.stat${n}.body`,
}));
---

<Layout
  title={t(lang, 'about.page.title')}
  description={t(lang, 'about.page.description')}
  titleKey="about.page.title"
  descriptionKey="about.page.description"
>

  <SiteHeader slot="header" lang={lang} />

  <PageHero
    lang={lang}
    eyebrowKey="about.hero.eyebrow"
    titleKey="about.hero.title"
    subtitleKey="about.hero.subtitle"
  >
    <p slot="extra" class="ab-kicker">
      <span data-i18n="about.hero.kicker">{t(lang, 'about.hero.kicker')}</span>
    </p>
  </PageHero>

  <!-- ── Story ──────────────────────────────────────────────── -->
  <section id="story" class="ab-story">
    <div class="container ab-story__inner">
      <div class="ab-story__text">
        <span class="eyebrow" data-i18n="about.story.eyebrow">{t(lang, 'about.story.eyebrow')}</span>
        <h2 class="ab-story__title">
          <span data-i18n="about.story.title">{t(lang, 'about.story.title')}</span>
        </h2>
        <p class="ab-story__lead">
          <span data-i18n="about.story.lead">{t(lang, 'about.story.lead')}</span>
        </p>

        <div class="ab-story__body">
          <p data-i18n="about.story.body1">{t(lang, 'about.story.body1')}</p>
          <p data-i18n="about.story.body2">{t(lang, 'about.story.body2')}</p>
          <p data-i18n="about.story.body3">{t(lang, 'about.story.body3')}</p>
        </div>

        <blockquote class="ab-pull">
          <span data-i18n="about.story.pull">{t(lang, 'about.story.pull')}</span>
        </blockquote>
      </div>

      <div class="ab-story__media">
        <div class="ab-photo ab-photo--main">
          <Image src={machine2} alt="" widths={[480, 720, 960]} sizes="(max-width: 900px) 90vw, 480px" />
        </div>
        <div class="ab-photo ab-photo--accent">
          <Image src={machine3} alt="" widths={[320, 480]} sizes="(max-width: 900px) 50vw, 240px" />
        </div>
        <div class="ab-years" aria-hidden="true">
          <span class="ab-years__num">25+</span>
          <span class="ab-years__label" data-i18n="about.story.badge.years">{t(lang, 'about.story.badge.years')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Timeline ───────────────────────────────────────────── -->
  <section class="ab-timeline-band">
    <div class="container">
      <ol class="ab-timeline" role="list">
        {timeline.map((item) => (
          <li class:list={['ab-timeline__item', item.now && 'ab-timeline__item--now']}>
            <span class="ab-timeline__year" data-i18n={item.labelKey}>{t(lang, item.labelKey)}</span>
            <p class="ab-timeline__title" data-i18n={item.titleKey}>{t(lang, item.titleKey)}</p>
            <p class="ab-timeline__body" data-i18n={item.bodyKey}>{t(lang, item.bodyKey)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Science: light, documentary ────────────────────────── -->
  <section id="science" class="ab-science">
    <div class="container">
      <header class="ab-science__header">
        <span class="eyebrow" data-i18n="about.science.eyebrow">{t(lang, 'about.science.eyebrow')}</span>
        <h2 class="ab-science__title">
          <span data-i18n="about.science.title">{t(lang, 'about.science.title')}</span>
        </h2>
        <p class="ab-science__intro">
          <span data-i18n="about.science.intro">{t(lang, 'about.science.intro')}</span>
        </p>
        <div class="ab-science__badge">
          <HaccpBadge lang={lang} size="md" />
        </div>
      </header>

      <div class="ab-stats">
        {stats.map((s) => (
          <article class="ab-stat">
            <span class="ab-stat__value" data-i18n={s.valueKey}>{t(lang, s.valueKey)}</span>
            <span class="ab-stat__label" data-i18n={s.labelKey}>{t(lang, s.labelKey)}</span>
            <p class="ab-stat__body" data-i18n={s.bodyKey}>{t(lang, s.bodyKey)}</p>
          </article>
        ))}
      </div>

      <blockquote class="ab-quote">
        <p class="ab-quote__text">
          <span data-i18n="about.science.quote">{t(lang, 'about.science.quote')}</span>
        </p>
        <cite class="ab-quote__attr">
          <span data-i18n="about.science.quote.attr">{t(lang, 'about.science.quote.attr')}</span>
        </cite>
      </blockquote>

      <div class="ab-process-link">
        <div>
          <h3 class="ab-process-link__title">
            <span data-i18n="kachestvo.process.title">{t(lang, 'kachestvo.process.title')}</span>
          </h3>
          <p class="ab-process-link__body">
            <span data-i18n="kachestvo.process.intro">{t(lang, 'kachestvo.process.intro')}</span>
          </p>
        </div>
        <Button variant="primary" href={`${base}kachestvo`}>
          <span data-i18n="home.quality.cta">{t(lang, 'home.quality.cta')}</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- ── Closing ────────────────────────────────────────────── -->
  <section class="ab-closing">
    <div class="container ab-closing__inner">
      <span class="eyebrow" data-i18n="about.closing.eyebrow">{t(lang, 'about.closing.eyebrow')}</span>
      <h2 class="ab-closing__title">
        <span data-i18n="about.closing.title">{t(lang, 'about.closing.title')}</span>
      </h2>
      <p class="ab-closing__body">
        <span data-i18n="about.closing.body">{t(lang, 'about.closing.body')}</span>
      </p>
      <div class="ab-closing__cta">
        <Button variant="primary" href={`${base}contact`}>
          <span data-i18n="about.closing.cta.contact">{t(lang, 'about.closing.cta.contact')}</span>
        </Button>
        <Button variant="ghost" href={`${base}b2b`}>
          <span data-i18n="about.closing.cta.partner">{t(lang, 'about.closing.cta.partner')}</span>
        </Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />

</Layout>

<style>
  .eyebrow {
    display:        inline-block;
    font-size:      var(--text-xs);
    font-weight:    var(--font-weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color:          var(--color-secondary-hover);
    margin-bottom:  var(--space-3);
  }

  .ab-kicker {
    margin-top:     var(--space-6);
    font-size:      var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color:          var(--color-text-muted);
    font-weight:    var(--font-weight-medium);
  }

  /* ── Story ──────────────────────────────────────────────── */
  .ab-story {
    background:    var(--color-surface);
    padding-block: var(--space-20);
  }

  .ab-story__inner {
    display:               grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap:                   var(--space-16);
    align-items:           start;
  }

  .ab-story__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-5);
  }

  .ab-story__lead {
    font-size:   var(--text-xl);
    color:       var(--color-text);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-relaxed);
    margin:      0 0 var(--space-6);
    max-width:   56ch;
  }

  .ab-story__body {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-5);
    max-width:      60ch;
  }

  .ab-story__body p {
    font-size:   var(--text-base);
    line-height: var(--leading-relaxed);
    color:       var(--color-text);
  }

  .ab-pull {
    margin:        var(--space-10) 0 0;
    padding:       var(--space-6) var(--space-8);
    border-left:   3px solid var(--color-secondary);
    background:    var(--color-tint);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    font-family:   var(--font-heading);
    font-size:     var(--text-xl);
    font-weight:   var(--font-weight-semibold);
    line-height:   var(--leading-tight);
    color:         var(--color-primary);
  }

  /* ── Story media ────────────────────────────────────────── */
  .ab-story__media {
    position:   relative;
    min-height: 540px;
  }

  .ab-photo {
    position:      absolute;
    border-radius: var(--radius-xl);
    overflow:      hidden;
    box-shadow:    0 20px 48px rgba(18, 37, 74, 0.14);
  }

  .ab-photo :global(img) {
    width:      100%;
    height:     100%;
    object-fit: cover;
    display:    block;
  }

  .ab-photo--main {
    top:          0;
    right:        0;
    width:        80%;
    aspect-ratio: 4 / 5;
  }

  .ab-photo--accent {
    bottom: 0;
    left:   0;
    width:  50%;
    aspect-ratio: 1 / 1;
    border: 6px solid var(--color-surface);
  }

  .ab-years {
    position:      absolute;
    bottom:        var(--space-8);
    right:         0;
    background:    var(--color-surface);
    border:        1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    box-shadow:    var(--shadow-lg);
    padding:       var(--space-4) var(--space-5);
    display:       flex;
    flex-direction: column;
  }

  .ab-years__num {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-3xl);
    color:          var(--color-primary);
    line-height:    1;
    letter-spacing: -0.02em;
  }

  .ab-years__label {
    margin-top:     var(--space-1);
    font-size:      var(--text-xs);
    font-weight:    var(--font-weight-medium);
    color:          var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ── Timeline band ──────────────────────────────────────── */
  .ab-timeline-band {
    background:    var(--color-bg);
    border-block:  1px solid var(--color-border-light);
    padding-block: var(--space-16);
  }

  .ab-timeline {
    list-style:            none;
    margin:                0;
    padding:               0;
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-8);
  }

  .ab-timeline__item {
    border-top:  2px solid var(--color-border-light);
    padding-top: var(--space-5);
  }

  .ab-timeline__item--now {
    border-top-color: var(--color-secondary);
  }

  .ab-timeline__year {
    display:        block;
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-2xl);
    color:          var(--color-primary);
    line-height:    1;
    margin-bottom:  var(--space-3);
  }

  .ab-timeline__title {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size:   var(--text-base);
    color:       var(--color-text);
    margin:      0 0 var(--space-2);
  }

  .ab-timeline__body {
    font-size:   var(--text-sm);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      0;
  }

  /* ── Science ────────────────────────────────────────────── */
  .ab-science {
    background:    var(--color-surface);
    padding-block: var(--space-20);
  }

  .ab-science__header {
    max-width:     680px;
    margin-bottom: var(--space-12);
  }

  .ab-science__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-4xl);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-4);
  }

  .ab-science__intro {
    font-size:   var(--text-lg);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      0 0 var(--space-6);
  }

  .ab-stats {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   var(--space-6);
    margin-bottom:         var(--space-12);
  }

  .ab-stat {
    background:    var(--color-bg);
    border:        1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding:       var(--space-8);
  }

  .ab-stat__value {
    display:        block;
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-5xl);
    line-height:    var(--leading-none);
    letter-spacing: -0.02em;
    color:          var(--color-primary);
  }

  .ab-stat__label {
    display:     block;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    font-size:   var(--text-base);
    color:       var(--color-text);
    margin-top:  var(--space-2);
  }

  .ab-stat__body {
    font-size:   var(--text-sm);
    color:       var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin:      var(--space-3) 0 0;
  }

  .ab-quote {
    max-width:     720px;
    margin:        0 auto var(--space-12);
    padding-block: var(--space-8);
    border-block:  1px solid var(--color-border-light);
    text-align:    center;
  }

  .ab-quote__text {
    font-family:    var(--font-heading);
    font-size:      var(--text-2xl);
    font-weight:    var(--font-weight-semibold);
    color:          var(--color-primary);
    line-height:    var(--leading-tight);
    letter-spacing: -0.01em;
    margin:         0 0 var(--space-5);
  }

  .ab-quote__attr {
    font-size:      var(--text-xs);
    font-weight:    var(--font-weight-semibold);
    font-style:     normal;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color:          var(--color-secondary-hover);
  }

  .ab-process-link {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             var(--space-8);
    background:      var(--color-tint);
    border-radius:   var(--radius-xl);
    padding:         var(--space-8);
  }

  .ab-process-link__title {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size:   var(--text-2xl);
    color:       var(--color-primary);
    margin:      0 0 var(--space-2);
  }

  .ab-process-link__body {
    font-size:   var(--text-base);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0;
    max-width:   56ch;
  }

  /* ── Closing ────────────────────────────────────────────── */
  .ab-closing {
    background:    linear-gradient(180deg, var(--color-bg) 0%, var(--color-tint) 100%);
    padding-block: var(--space-20);
  }

  .ab-closing__inner {
    text-align: center;
    max-width:  680px;
  }

  .ab-closing__title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-bold);
    font-size:      var(--text-5xl);
    color:          var(--color-primary);
    line-height:    var(--leading-none);
    letter-spacing: -0.015em;
    margin:         0 0 var(--space-5);
  }

  .ab-closing__body {
    font-size:   var(--text-xl);
    color:       var(--color-text);
    line-height: var(--leading-relaxed);
    margin:      0 0 var(--space-8);
  }

  .ab-closing__cta {
    display:         inline-flex;
    flex-wrap:       wrap;
    justify-content: center;
    gap:             var(--space-4);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .ab-story__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .ab-story__media {
      min-height: 480px;
      max-width:  520px;
    }
  }

  @media (max-width: 768px) {
    .ab-story,
    .ab-science,
    .ab-closing { padding-block: var(--space-16); }

    .ab-timeline { grid-template-columns: 1fr; }
    .ab-stats    { grid-template-columns: 1fr; }

    .ab-story__media { min-height: 420px; }

    .ab-process-link {
      flex-direction: column;
      align-items:    flex-start;
    }

    .ab-closing__cta { flex-direction: column; align-items: stretch; width: 100%; }
    .ab-closing__cta :global(.btn) { width: 100%; }
  }
</style>
