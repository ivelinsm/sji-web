---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Heading from '../components/Heading.astro';
import Navbar from '../components/Navbar.astro';
import NavLink from '../components/NavLink.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import Badge from '../components/Badge.astro';
import FiltrationSection from '../components/FiltrationSection.astro';
import HaccpBadge from '../components/HaccpBadge.astro';
import { t } from '../i18n/utils';
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.webp';
import Footer from '../components/Footer.astro';
import machine1 from '../assets/machine-1.webp';
import machine2 from '../assets/machine-2.webp';
import machine3 from '../assets/machine-3.webp';

const lang = 'bg';
const base = import.meta.env.BASE_URL;

const heroBg = await getImage({ src: machine1, format: 'webp', width: 2000 });
---

<Layout title={t(lang, 'about.page.title')} description={t(lang, 'about.page.description')}>

  <!-- ── Navbar ─────────────────────────────────────────────── -->
  <Navbar slot="header" variant="transparent">
    <Image slot="logo" src={logo} alt="SJI" class="nav-logo" />
    <NavLink slot="links" href={base}><span data-i18n="nav.home">{t(lang, 'nav.home')}</span></NavLink>
    <NavLink slot="links" href={`${base}products`}><span data-i18n="nav.products">{t(lang, 'nav.products')}</span></NavLink>
    <NavLink slot="links" href={`${base}about`}><span data-i18n="nav.about">{t(lang, 'nav.about')}</span></NavLink>
    <NavLink slot="links" href={`${base}contact`}><span data-i18n="nav.contact">{t(lang, 'nav.contact')}</span></NavLink>
    <Button slot="actions" variant="ghost-white" href={`${base}contact`} size="sm">
      <span data-i18n="nav.cta.enquiry">{t(lang, 'nav.cta.enquiry')}</span>
    </Button>
    <LangSwitcher slot="actions" />
  </Navbar>

  <!-- ═══════════════════════════════════════════════════════════
       1 · HERO
       ═══════════════════════════════════════════════════════════ -->
  <section class="ab-hero" style={`--ab-hero-img: url(${heroBg.src})`}>
    <span class="ab-hero__glow ab-hero__glow--a" aria-hidden="true"></span>
    <span class="ab-hero__glow ab-hero__glow--b" aria-hidden="true"></span>
    <span class="ab-hero__grid" aria-hidden="true"></span>

    <div class="container ab-hero__inner">
      <div class="ab-hero__content reveal">
        <span class="ab-hero__eyebrow">
          <span class="ab-hero__eyebrow-dot" aria-hidden="true"></span>
          <span data-i18n="about.hero.eyebrow">{t(lang, 'about.hero.eyebrow')}</span>
        </span>

        <Heading level={1} color="white" class="ab-hero__title">
          <span data-i18n="about.hero.title">{t(lang, 'about.hero.title')}</span>
        </Heading>

        <p class="ab-hero__subtitle">
          <span data-i18n="about.hero.subtitle">{t(lang, 'about.hero.subtitle')}</span>
        </p>

        <div class="ab-hero__cta">
          <Button variant="ghost-white-primary" href="#process">
            <span data-i18n="about.hero.cta.process">{t(lang, 'about.hero.cta.process')}</span>
          </Button>
          <Button variant="ghost-white" href="#story">
            <span data-i18n="about.hero.cta.learn">{t(lang, 'about.hero.cta.learn')}</span>
          </Button>
        </div>

        <p class="ab-hero__kicker">
          <span data-i18n="about.hero.kicker">{t(lang, 'about.hero.kicker')}</span>
        </p>
      </div>
    </div>

    <span class="ab-hero__scroll" aria-hidden="true">
      <span class="ab-hero__scroll-line"></span>
    </span>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       2 · STORY · two-column editorial
       ═══════════════════════════════════════════════════════════ -->
  <section id="story" class="ab-story">
    <div class="container ab-story__inner">

      <div class="ab-story__text reveal">
        <span class="ab-eyebrow">
          <span data-i18n="about.story.eyebrow">{t(lang, 'about.story.eyebrow')}</span>
        </span>
        <Heading level={2} class="ab-story__title">
          <span data-i18n="about.story.title">{t(lang, 'about.story.title')}</span>
        </Heading>
        <p class="ab-story__lead">
          <span data-i18n="about.story.lead">{t(lang, 'about.story.lead')}</span>
        </p>

        <div class="ab-story__body">
          <p data-i18n="about.story.body1">{t(lang, 'about.story.body1')}</p>
          <p data-i18n="about.story.body2">{t(lang, 'about.story.body2')}</p>
          <p data-i18n="about.story.body3">{t(lang, 'about.story.body3')}</p>
        </div>

        <blockquote class="ab-story__pull">
          <span class="ab-story__pull-mark" aria-hidden="true">“</span>
          <span data-i18n="about.story.pull">{t(lang, 'about.story.pull')}</span>
        </blockquote>

        <!-- Timeline -->
        <ol class="ab-timeline" role="list">
          <li class="ab-timeline__item reveal">
            <span class="ab-timeline__year" data-i18n="about.timeline.2000.label">{t(lang, 'about.timeline.2000.label')}</span>
            <span class="ab-timeline__dot" aria-hidden="true"></span>
            <p class="ab-timeline__title" data-i18n="about.timeline.2000.title">{t(lang, 'about.timeline.2000.title')}</p>
            <p class="ab-timeline__body" data-i18n="about.timeline.2000.body">{t(lang, 'about.timeline.2000.body')}</p>
          </li>
          <li class="ab-timeline__item reveal">
            <span class="ab-timeline__year" data-i18n="about.timeline.2012.label">{t(lang, 'about.timeline.2012.label')}</span>
            <span class="ab-timeline__dot" aria-hidden="true"></span>
            <p class="ab-timeline__title" data-i18n="about.timeline.2012.title">{t(lang, 'about.timeline.2012.title')}</p>
            <p class="ab-timeline__body" data-i18n="about.timeline.2012.body">{t(lang, 'about.timeline.2012.body')}</p>
          </li>
          <li class="ab-timeline__item ab-timeline__item--now reveal">
            <span class="ab-timeline__year" data-i18n="about.timeline.today.label">{t(lang, 'about.timeline.today.label')}</span>
            <span class="ab-timeline__dot" aria-hidden="true"></span>
            <p class="ab-timeline__title" data-i18n="about.timeline.today.title">{t(lang, 'about.timeline.today.title')}</p>
            <p class="ab-timeline__body" data-i18n="about.timeline.today.body">{t(lang, 'about.timeline.today.body')}</p>
          </li>
        </ol>
      </div>

      <div class="ab-story__media reveal">
        <div class="ab-story__photo ab-story__photo--main">
          <Image src={machine2} alt="" widths={[480, 720, 960, 1200]} sizes="(max-width: 900px) 90vw, 520px" />
        </div>
        <div class="ab-story__photo ab-story__photo--accent">
          <Image src={machine3} alt="" widths={[320, 480, 640]} sizes="(max-width: 900px) 60vw, 280px" />
        </div>
        <div class="ab-story__badge" aria-hidden="true">
          <span class="ab-story__badge-num">25+</span>
          <span class="ab-story__badge-label" data-i18n="about.story.badge.years">{t(lang, 'about.story.badge.years')}</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       3 · SCIENCE · dark, statistical
       ═══════════════════════════════════════════════════════════ -->
  <section id="science" class="ab-science">
    <span class="ab-science__grid" aria-hidden="true"></span>
    <span class="ab-science__glow" aria-hidden="true"></span>

    <div class="container ab-science__inner">

      <header class="ab-science__header reveal">
        <span class="ab-eyebrow ab-eyebrow--on-dark">
          <span data-i18n="about.science.eyebrow">{t(lang, 'about.science.eyebrow')}</span>
        </span>
        <Heading level={2} color="white" align="center" class="ab-science__title">
          <span data-i18n="about.science.title">{t(lang, 'about.science.title')}</span>
        </Heading>
        <p class="ab-science__intro">
          <span data-i18n="about.science.intro">{t(lang, 'about.science.intro')}</span>
        </p>

        <div class="ab-science__trust">
          <HaccpBadge variant="dark" size="md" lang={lang} />
          <p class="ab-science__trust-caption">
            <span data-i18n="certifications.haccp.description">{t(lang, 'certifications.haccp.description')}</span>
          </p>
        </div>
      </header>

      <div class="ab-stats">
        <article class="ab-stat reveal">
          <span class="ab-stat__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M9 3v4l-5 9a4 4 0 0 0 4 6h8a4 4 0 0 0 4-6l-5-9V3" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M6 14h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="10" cy="17" r="0.8" fill="currentColor"/>
              <circle cx="14" cy="18" r="0.8" fill="currentColor"/>
            </svg>
          </span>
          <span class="ab-stat__value" data-i18n="about.science.stat1.value">{t(lang, 'about.science.stat1.value')}</span>
          <span class="ab-stat__label" data-i18n="about.science.stat1.label">{t(lang, 'about.science.stat1.label')}</span>
          <p class="ab-stat__body" data-i18n="about.science.stat1.body">{t(lang, 'about.science.stat1.body')}</p>
        </article>

        <article class="ab-stat ab-stat--feature reveal">
          <span class="ab-stat__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <path d="M3 9h18" stroke="currentColor" stroke-width="1.75"/>
              <path d="M8 13h3M8 17h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M15 13l2 2 3-3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="ab-stat__value" data-i18n="about.science.stat2.value">{t(lang, 'about.science.stat2.value')}</span>
          <span class="ab-stat__label" data-i18n="about.science.stat2.label">{t(lang, 'about.science.stat2.label')}</span>
          <p class="ab-stat__body" data-i18n="about.science.stat2.body">{t(lang, 'about.science.stat2.body')}</p>
        </article>

        <article class="ab-stat reveal">
          <span class="ab-stat__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/>
              <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="ab-stat__value" data-i18n="about.science.stat3.value">{t(lang, 'about.science.stat3.value')}</span>
          <span class="ab-stat__label" data-i18n="about.science.stat3.label">{t(lang, 'about.science.stat3.label')}</span>
          <p class="ab-stat__body" data-i18n="about.science.stat3.body">{t(lang, 'about.science.stat3.body')}</p>
        </article>
      </div>

      <blockquote class="ab-science__quote reveal">
        <svg class="ab-science__quote-mark" width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 7c-2 1-3 3-3 6v4h6V9H6m13 -2c-2 1-3 3-3 6v4h6V9h-4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        <p class="ab-science__quote-text">
          <span data-i18n="about.science.quote">{t(lang, 'about.science.quote')}</span>
        </p>
        <cite class="ab-science__quote-attr">
          <span data-i18n="about.science.quote.attr">{t(lang, 'about.science.quote.attr')}</span>
        </cite>
      </blockquote>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       4 · FILTRATION · existing component (gray section)
       ═══════════════════════════════════════════════════════════ -->
  <div id="process">
    <FiltrationSection lang={lang} />
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       5 · MONITORING · sensors / real-time
       ═══════════════════════════════════════════════════════════ -->
