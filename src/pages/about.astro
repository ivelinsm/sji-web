<!-- ── Reveal-on-scroll ──────────────────────────────────────── -->
<script>
  const targets = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window && targets.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    targets.forEach((el) => io.observe(el));
  } else {
    targets.forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>
  /* ─────────────────────────────────────────────────────────────
     Shared utility — eyebrow & reveal
     ───────────────────────────────────────────────────────────── */
  .ab-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-secondary-hover);
    margin-bottom: var(--space-4);
  }

  .ab-eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }

  .ab-eyebrow--on-dark {
    color: var(--color-secondary);
  }

  /* Applied to <Image> — needs :global to cross scope */
  :global(.nav-logo) {
    height: 52px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Reveal animation (respects reduced motion) */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ─────────────────────────────────────────────────────────────
     1 · HERO
     ───────────────────────────────────────────────────────────── */
  .ab-hero {
    position: relative;
    isolation: isolate;
    min-height: 92vh;
    margin-top: -72px;
    padding-top: calc(72px + var(--space-20));
    padding-bottom: var(--space-24);
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(8, 18, 55, 0.78) 0%, rgba(8, 18, 55, 0.55) 50%, rgba(26, 51, 102, 0.85) 100%),
      var(--ab-hero-img) center / cover no-repeat;
    background-color: var(--color-primary-dark);
    color: var(--color-white);
  }

  .ab-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 30% 50%, rgba(0, 0, 0, 0.7) 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 30% 50%, rgba(0, 0, 0, 0.7) 0%, transparent 70%);
    pointer-events: none;
  }

  .ab-hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
    pointer-events: none;
    z-index: -1;
  }
  .ab-hero__glow--a {
    top: -120px;
    right: -80px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(39, 169, 216, 0.45) 0%, transparent 70%);
  }
  .ab-hero__glow--b {
    bottom: -160px;
    left: -120px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(47, 85, 151, 0.55) 0%, transparent 70%);
  }

  .ab-hero__inner {
    position: relative;
    z-index: 1;
  }

  .ab-hero__content {
    max-width: 720px;
  }

  .ab-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: var(--space-8);
  }

  .ab-hero__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-secondary);
    box-shadow: 0 0 0 4px rgba(39, 169, 216, 0.22);
    animation: ab-pulse 2.2s ease-in-out infinite;
  }
  @keyframes ab-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }

  /* Heading lives inside Heading.astro — needs :global to cross scope */
  :global(.ab-hero__title) {
    font-size: clamp(var(--text-4xl), 5.4vw, 4.25rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .ab-hero__subtitle {
    margin-top: var(--space-6);
    max-width: 600px;
    font-size: var(--text-xl);
    color: rgba(255, 255, 255, 0.78);
    line-height: var(--leading-relaxed);
  }

  .ab-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  .ab-hero__kicker {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    font-weight: var(--font-weight-medium);
  }

  .ab-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-8);
    transform: translateX(-50%);
    width: 2px;
    height: 56px;
    overflow: hidden;
    opacity: 0.6;
  }
  .ab-hero__scroll-line {
    display: block;
    width: 100%;
    height: 24px;
    background: linear-gradient(to bottom, transparent, var(--color-white));
    animation: ab-scroll 2.4s ease-in-out infinite;
  }
  @keyframes ab-scroll {
    0%   { transform: translateY(-32px); opacity: 0; }
    35%  { opacity: 1; }
    100% { transform: translateY(56px); opacity: 0; }
  }

  /* ─────────────────────────────────────────────────────────────
     2 · STORY
     ───────────────────────────────────────────────────────────── */
  .ab-story {
    background: var(--color-surface);
    padding-block: var(--space-24);
    position: relative;
  }

  .ab-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-20);
    align-items: start;
  }

  :global(.ab-story__title) {
    font-size: clamp(var(--text-3xl), 3.6vw, var(--text-5xl));
    letter-spacing: -0.015em;
    margin-bottom: var(--space-6);
    padding-bottom: 20px;
  }

  .ab-story__lead {
    font-size: var(--text-xl);
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 56ch;
  }

  .ab-story__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 60ch;
  }
  .ab-story__body p {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .ab-story__pull {
    margin: var(--space-12) 0;
    padding: var(--space-6) var(--space-8);
    border-left: 3px solid var(--color-secondary);
    background: linear-gradient(90deg, var(--color-secondary-light) 0%, transparent 100%);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-primary);
    letter-spacing: -0.01em;
    position: relative;
  }
  .ab-story__pull-mark {
    position: absolute;
    top: -6px;
    left: var(--space-4);
    font-family: var(--font-heading);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--color-secondary);
    opacity: 0.6;
  }

  /* ── Timeline ───────────────────────────────────────────────── */
  .ab-timeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-10);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border-light);
  }

  .ab-timeline__item {
    position: relative;
    padding-top: var(--space-6);
  }

  .ab-timeline__item::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-border-light);
  }
  .ab-timeline__item--now::before {
    background: linear-gradient(90deg, var(--color-secondary) 0%, var(--color-primary) 100%);
  }

  .ab-timeline__dot {
    position: absolute;
    top: -5px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 2px solid var(--color-secondary);
  }
  .ab-timeline__item--now .ab-timeline__dot {
    background: var(--color-secondary);
    box-shadow: 0 0 0 6px var(--color-secondary-alpha-10);
  }

  .ab-timeline__year {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    letter-spacing: -0.01em;
    line-height: 1;
    margin-bottom: var(--space-3);
  }

  .ab-timeline__title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin: 0;
  }

  .ab-timeline__body {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Story media (floating images + badge) ──────────────────── */
  .ab-story__media {
    position: relative;
    min-height: 600px;
  }

  .ab-story__photo {
    position: absolute;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.16);
    background: var(--color-primary-dark);
    transition: transform var(--transition-slow);
  }
  .ab-story__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ab-story__photo--main {
    top: 0;
    right: 0;
    width: 78%;
    aspect-ratio: 4 / 5;
    z-index: 2;
  }

  .ab-story__photo--accent {
    bottom: 0;
    left: 0;
    width: 56%;
    aspect-ratio: 1 / 1;
    z-index: 1;
    border: 6px solid var(--color-surface);
  }

  .ab-story__media:hover .ab-story__photo--main {
    transform: translateY(-4px);
  }
  .ab-story__media:hover .ab-story__photo--accent {
    transform: translateY(4px);
  }

  .ab-story__badge {
    position: absolute;
    bottom: var(--space-6);
    right: calc(-1 * var(--space-4));
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border-light);
  }
  .ab-story__badge-num {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ab-story__badge-label {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ─────────────────────────────────────────────────────────────
     3 · SCIENCE
     ───────────────────────────────────────────────────────────── */
  .ab-science {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 70% 0%, rgba(39, 169, 216, 0.18) 0%, transparent 55%),
      linear-gradient(180deg, var(--color-primary-dark) 0%, #0f1f4a 100%);
    color: var(--color-white);
    padding-block: var(--space-24);
    overflow: hidden;
  }

  .ab-science__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
    pointer-events: none;
  }

  .ab-science__glow {
    position: absolute;
    top: 30%;
    left: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(39, 169, 216, 0.22) 0%, transparent 70%);
    filter: blur(60px);
    z-index: -1;
    pointer-events: none;
  }

  .ab-science__header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  :global(.ab-science__title) {
    font-size: clamp(var(--text-3xl), 3.6vw, var(--text-5xl));
    letter-spacing: -0.015em;
  }

  .ab-science__intro {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.78);
    line-height: var(--leading-relaxed);
  }

  .ab-science__trust {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            var(--space-3);
    margin-top:     var(--space-8);
  }

  .ab-science__trust-caption {
    font-size:   var(--text-sm);
    color:       rgba(255, 255, 255, 0.62);
    line-height: var(--leading-normal);
    max-width:   420px;
    margin:      0;
    text-align:  center;
  }

  /* ── Stat cards ─────────────────────────────────────────────── */
  .ab-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-16);
  }

  .ab-stat {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      transform var(--transition-slow),
      background var(--transition-slow),
      border-color var(--transition-slow);
  }

  .ab-stat:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(39, 169, 216, 0.42);
  }

  .ab-stat--feature {
    background: linear-gradient(160deg, rgba(39, 169, 216, 0.18) 0%, rgba(39, 169, 216, 0.04) 100%);
    border-color: rgba(39, 169, 216, 0.32);
  }

  .ab-stat__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: rgba(39, 169, 216, 0.16);
    color: var(--color-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .ab-stat__value {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-4xl), 4.5vw, 3.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, #fff 0%, var(--color-secondary) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    margin-bottom: var(--space-3);
  }

  .ab-stat__label {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-white);
    letter-spacing: -0.005em;
    margin-bottom: var(--space-3);
  }

  .ab-stat__body {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.62);
  }

  /* ── Quote ──────────────────────────────────────────────────── */
  .ab-science__quote {
    max-width: 760px;
    margin-inline: auto;
    padding: var(--space-10) var(--space-8);
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
  }

  .ab-science__quote-mark {
    color: var(--color-secondary);
    margin-bottom: var(--space-4);
    opacity: 0.85;
  }

  .ab-science__quote-text {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 2.6vw, var(--text-3xl));
    font-weight: var(--font-weight-semibold);
    color: var(--color-white);
    line-height: var(--leading-tight);
    letter-spacing: -0.015em;
  }

  .ab-science__quote-attr {
    display: inline-block;
    margin-top: var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    font-style: normal;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  /* ─────────────────────────────────────────────────────────────
     5 · MONITORING
     ───────────────────────────────────────────────────────────── */
  .ab-monitoring {
    background: var(--color-surface);
    padding-block: var(--space-24);
    position: relative;
    overflow: hidden;
  }

  .ab-monitoring::before {
    content: "";
    position: absolute;
    top: 10%;
    right: -10%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, var(--color-secondary-alpha-10) 0%, transparent 70%);
    filter: blur(50px);
    pointer-events: none;
  }

  .ab-monitoring__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
    position: relative;
  }

  /* ── Media side ─────────────────────────────────────────────── */
  .ab-monitoring__media {
    position: relative;
    min-height: 560px;
  }

  .ab-monitoring__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: 0 30px 70px rgba(15, 23, 42, 0.20);
    background: var(--color-primary-dark);
    isolation: isolate;
  }
  .ab-monitoring__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ab-monitoring__photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(140deg, rgba(8, 18, 55, 0.08) 0%, rgba(8, 18, 55, 0.45) 100%);
    z-index: 1;
  }

  /* Floating chip "Live" */
  .ab-chip {
    position: absolute;
    top: var(--space-6);
    left: var(--space-6);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text);
  }

  .ab-chip__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.22);
    animation: ab-pulse 1.6s ease-in-out infinite;
  }

  /* Big stat card (99.99%) */
  .ab-stat-card {
    position: absolute;
    z-index: 3;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.14);
    border: 1px solid var(--color-border-light);
  }

  .ab-stat-card--big {
    right: calc(-1 * var(--space-6));
    bottom: var(--space-12);
    width: 240px;
    padding: var(--space-6);
  }

  .ab-stat-card__value {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ab-stat-card__label {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ab-stat-card__bars {
    display: flex;
    gap: 4px;
    margin-top: var(--space-5);
    height: 24px;
    align-items: flex-end;
  }
  .ab-stat-card__bars span {
    flex: 1;
    background: var(--color-secondary);
    border-radius: 2px;
    opacity: 0.85;
  }
  .ab-stat-card__bars span:nth-child(1) { height: 45%; }
  .ab-stat-card__bars span:nth-child(2) { height: 70%; }
  .ab-stat-card__bars span:nth-child(3) { height: 55%; }
  .ab-stat-card__bars span:nth-child(4) { height: 85%; }
  .ab-stat-card__bars span:nth-child(5) { height: 65%; }

  /* Mini stat card */
  .ab-stat-card--mini {
    left: calc(-1 * var(--space-6));
    top: var(--space-16);
    width: 220px;
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ab-stat-card__row {
    display: grid;
    grid-template-columns: 10px 1fr auto;
    gap: var(--space-3);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .ab-stat-card__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
  }
  .ab-stat-card__dot--ok {
    background: #22c55e;
  }
  .ab-stat-card__num {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    font-size: var(--text-xs);
  }

  /* ── Text side ──────────────────────────────────────────────── */
  :global(.ab-monitoring__title) {
    font-size: clamp(var(--text-3xl), 3.6vw, var(--text-5xl));
    letter-spacing: -0.015em;
    margin-bottom: var(--space-6);
  }

  .ab-monitoring__lead {
    font-size: var(--text-xl);
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .ab-monitoring__body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-8);
    max-width: 56ch;
  }

  /* Feature list */
  .ab-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .ab-feature {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .ab-feature__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-secondary-light);
    color: var(--color-secondary-hover);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ab-feature__title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin: 0;
  }

  .ab-feature__body {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ─────────────────────────────────────────────────────────────
     6 · CLOSING
     ───────────────────────────────────────────────────────────── */
  .ab-closing {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-24);
    background:
      radial-gradient(ellipse at 50% 0%, var(--color-secondary-light) 0%, transparent 60%),
      linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
    overflow: hidden;
    text-align: center;
  }

  .ab-closing__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -1;
    pointer-events: none;
  }
  .ab-closing__glow--a {
    top: -120px;
    left: 10%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(39, 169, 216, 0.25) 0%, transparent 70%);
  }
  .ab-closing__glow--b {
    bottom: -180px;
    right: 5%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(47, 85, 151, 0.15) 0%, transparent 70%);
  }

  .ab-closing__inner {
    max-width: 760px;
    margin-inline: auto;
  }

  .ab-closing__inner .ab-eyebrow {
    justify-content: center;
  }

  .ab-closing__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-3xl), 4.2vw, 3.75rem);
    font-weight: var(--font-weight-bold);
