---
import '../styles/global.css';
import bg from '../i18n/bg.json';
import en from '../i18n/en.json';
import logo from '../assets/logo.webp';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  /** i18n keys for this page's title/description so the runtime language
      switcher swaps to the page-specific values, not the homepage ones. */
  titleKey?: string;
  descriptionKey?: string;
}

const base = import.meta.env.BASE_URL;

const {
  title,
  description = bg['meta.description'],
  ogImage = `${base}og-image.jpg`,
  ogType = 'website',
  titleKey = 'meta.title',
  descriptionKey = 'meta.description',
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
// Social platforms require absolute URLs for og:image / twitter:image.
const ogImageURL = Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;
const translations = { bg, en };

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'СЖИ Груп ЕООД',
  alternateName: 'SJI Group Ltd',
  url: Astro.site ? Astro.site.toString() : 'https://sjigrup.com/',
  logo: Astro.site ? new URL(logo.src, Astro.site).toString() : logo.src,
  sameAs: ['https://www.facebook.com/aquavivawater/'],
});
---

<!doctype html>
<html lang="bg" data-lang="bg" data-title-key={titleKey} data-desc-key={descriptionKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Runs synchronously before paint - defaults to Bulgarian, honors prior user choice -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('sji-lang');
        var lang = stored === 'en' ? 'en' : 'bg';
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:type"        content={ogType} />
    <meta property="og:site_name"   content="СЖИ Груп" />
    <meta property="og:locale"      content="bg_BG" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <!-- Structured data -->
    <script type="application/ld+json" set:html={orgSchema} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`}>
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`}>
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`}>
    <link rel="icon" href={`${base}favicon.ico`} sizes="any">
    <link rel="manifest" href={`${base}site.webmanifest`}>

    <!-- Fonts: Sofia Sans (Bulgarian-designed, Cyrillic headings) · Onest (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sofia+Sans:wght@600;700;800&family=Onest:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Page-level head slot (additional meta, scripts, etc.) -->
    <slot name="head" />
  </head>

  <body>
    <slot name="header" />

    <main>
      <slot />
    </main>

    <footer>
      <slot name="footer" />
    </footer>

    <!-- i18n engine: apply translations + expose window.__setLang -->
    <script is:inline define:vars={{ translations }}>
      window.__translations = translations;

      function __applyLang(lang) {
        var t = window.__translations[lang] || window.__translations['bg'];

        // Fade out, swap text, fade back in
        document.body.classList.add('lang-switching');

        setTimeout(function () {
          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var key = el.getAttribute('data-i18n');
            if (t[key] !== undefined) el.textContent = t[key];
          });

          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.lang = lang;
          localStorage.setItem('sji-lang', lang);
          window.__lang = lang;

          // Swap to this page's own title/description keys (set by Layout props),
          // falling back to the site-wide meta keys.
          var titleKey = document.documentElement.getAttribute('data-title-key') || 'meta.title';
          var descKey  = document.documentElement.getAttribute('data-desc-key')  || 'meta.description';
          if (t[titleKey]) document.title = t[titleKey];
          if (t[descKey]) {
            var metaDesc = document.querySelector('meta[name="description"]');
            if (metaDesc) metaDesc.setAttribute('content', t[descKey]);
          }

          // Update all switcher labels
          document.querySelectorAll('[data-lang-label]').forEach(function (el) {
            el.textContent = lang === 'bg' ? 'EN' : 'BG';
          });

          document.body.classList.remove('lang-switching');
        }, 120);
      }

      window.__setLang = __applyLang;

      // Apply detected language on first load
      var initialLang = document.documentElement.getAttribute('data-lang') || 'bg';
      window.__lang = initialLang;
      if (initialLang !== 'bg') __applyLang(initialLang);

      // Sync switcher labels to detected language on first load
      document.querySelectorAll('[data-lang-label]').forEach(function (el) {
        el.textContent = initialLang === 'bg' ? 'EN' : 'BG';
      });
    </script>
  </body>
</html>
