---
interface Props {
  icon: string;
  title: string;
  titleKey: string;
  description: string;
  descKey: string;
  ctaLabel: string;
  ctaKey: string;
  ctaHref?: string;
}

const {
  icon,
  title,
  titleKey,
  description,
  descKey,
  ctaLabel,
  ctaKey,
  ctaHref = '#',
} = Astro.props;
---

<div class="svc-card">

  <!-- Ghost watermark - same icon, scaled large, faded white -->
  <div class="svc-card__watermark" aria-hidden="true" set:html={icon} />

  <!-- Foreground icon in tinted container -->
  <div class="svc-card__icon-wrap" aria-hidden="true" set:html={icon} />

  <div class="svc-card__body">
    <h3 class="svc-card__title">
      <span data-i18n={titleKey}>{title}</span>
    </h3>
    <p class="svc-card__desc">
      <span data-i18n={descKey}>{description}</span>
    </p>
  </div>

  <a href={ctaHref} class="svc-card__cta">
    <span data-i18n={ctaKey}>{ctaLabel}</span>
    <svg class="svc-card__cta-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</div>

<style>
  /* ── Card shell ──────────────────────────────────────────── */
  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(15, 23, 42, 0.05);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.03),
      0 6px 20px rgba(15, 23, 42, 0.05);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .svc-card:hover {
    transform: translateY(-4px);
    border-color: rgba(15, 23, 42, 0.08);
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.04),
      0 12px 24px rgba(15, 23, 42, 0.06),
      0 30px 60px rgba(15, 23, 42, 0.10);
  }

  /* ── Ghost watermark icon (bottom-right, large, faded) ───── */
  .svc-card__watermark {
    position: absolute;
    right: -28px;
    bottom: -32px;
    color: rgba(39, 169, 216, 0.07);
    pointer-events: none;
    z-index: 0;
    transition: transform var(--transition-slow), color var(--transition-slow);
  }

  .svc-card__watermark :global(svg) {
    width: 180px;
    height: 180px;
  }

  .svc-card:hover .svc-card__watermark {
    transform: translate(-4px, -6px) rotate(-4deg);
    color: rgba(39, 169, 216, 0.13);
  }

  /* ── Foreground icon (no container - clean glyph) ───────── */
  .svc-card__icon-wrap {
    position: relative;
    z-index: 2;
    display: inline-flex;
    color: var(--color-secondary);
    margin-bottom: var(--space-6);
    transform-origin: left center;
    transition: transform var(--transition-base);
  }

  .svc-card:hover .svc-card__icon-wrap {
    transform: scale(1.08);
  }

  .svc-card__icon-wrap :global(svg) {
    display: block;
    width: 36px;
    height: 36px;
    stroke-width: 1.5;
  }

  /* ── Body text ───────────────────────────────────────────── */
  .svc-card__body {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .svc-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .svc-card__desc {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ── CTA ─────────────────────────────────────────────────── */
  .svc-card__cta {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    width: fit-content;
    transition:
      color var(--transition-base),
      gap var(--transition-base);
  }

  .svc-card__cta:hover {
    color: var(--color-secondary-hover);
    gap: var(--space-3);
  }

  .svc-card__cta-arrow {
    flex-shrink: 0;
    transition: transform var(--transition-base);
  }

  .svc-card__cta:hover .svc-card__cta-arrow {
    transform: translateX(3px);
  }
</style>
