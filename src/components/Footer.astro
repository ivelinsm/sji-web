---
import { Image } from 'astro:assets';
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import logo from '../assets/logo.webp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <span class="site-footer__glow" aria-hidden="true"></span>

  <div class="container site-footer__inner">
    <div class="site-footer__grid">

      <!-- Column 1: Brand -->
      <div class="site-footer__col site-footer__col--brand">
        <a href={base} class="site-footer__logo-link" aria-label="СЖИ - Начало">
          <Image src={logo} alt="СЖИ" class="site-footer__logo" />
        </a>
        <p class="site-footer__tagline">
          <span data-i18n="footer.tagline">{t(lang, 'footer.tagline')}</span>
        </p>
        <div class="site-footer__socials">
          <a
            href="https://www.facebook.com/aquavivawater/"
            class="site-footer__social-link"
            aria-label="Facebook"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
            <span data-i18n="footer.social.facebook">{t(lang, 'footer.social.facebook')}</span>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation -->
      <div class="site-footer__col">
        <h3 class="site-footer__col-title">
          <span data-i18n="footer.nav.title">{t(lang, 'footer.nav.title')}</span>
        </h3>
        <ul class="site-footer__links">
          <li><a href={base} class="site-footer__link"><span data-i18n="nav.home">{t(lang, 'nav.home')}</span></a></li>
          <li><a href={`${base}products`} class="site-footer__link"><span data-i18n="nav.products">{t(lang, 'nav.products')}</span></a></li>
          <li><a href={`${base}about`} class="site-footer__link"><span data-i18n="nav.about">{t(lang, 'nav.about')}</span></a></li>
          <li><a href={`${base}contact`} class="site-footer__link"><span data-i18n="nav.contact">{t(lang, 'nav.contact')}</span></a></li>
        </ul>
      </div>

      <!-- Column 3: Services -->
      <div class="site-footer__col">
        <h3 class="site-footer__col-title">
          <span data-i18n="footer.services.title">{t(lang, 'footer.services.title')}</span>
        </h3>
        <ul class="site-footer__links">
          <li>
            <a href={`${base}contact`} class="site-footer__link">
              <span data-i18n="footer.services.delivery">{t(lang, 'footer.services.delivery')}</span>
            </a>
          </li>
          <li>
            <a href={`${base}products#b2b`} class="site-footer__link">
              <span data-i18n="footer.services.b2b">{t(lang, 'footer.services.b2b')}</span>
            </a>
          </li>
          <li>
            <a href={`${base}contact`} class="site-footer__link">
              <span data-i18n="footer.services.co2">{t(lang, 'footer.services.co2')}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contact Info -->
      <div class="site-footer__col">
        <h3 class="site-footer__col-title">
          <span data-i18n="footer.info.title">{t(lang, 'footer.info.title')}</span>
        </h3>
        <ul class="site-footer__info-list">
          <li class="site-footer__info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 6h16v12H4z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            </svg>
            <a
              class="site-footer__link obfuscated-email"
              href="#"
              data-user="sjigrup"
              data-domain="abv.bg"
              aria-label="Email"
            >sjigrup [at] abv.bg</a>
          </li>
          <li class="site-footer__info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            </svg>
            <span class="site-footer__phone-row">
              <span class="site-footer__phone-tag" data-i18n="footer.info.phone.orders">{t(lang, 'footer.info.phone.orders')}</span>
              <a
                class="site-footer__link obfuscated-phone"
                href="#"
                data-cc="359"
                data-rest="896730843"
                data-display="896 730 843"
                aria-label="Phone for orders and deliveries"
              >+359 …</a>
            </span>
          </li>
          <li class="site-footer__info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            </svg>
            <span class="site-footer__phone-row">
              <span class="site-footer__phone-tag" data-i18n="footer.info.phone.business">{t(lang, 'footer.info.phone.business')}</span>
              <a
                class="site-footer__link obfuscated-phone"
                href="#"
                data-cc="359"
                data-rest="896697480"
                data-display="896 697 480"
                aria-label="Phone for business inquiries"
              >+359 …</a>
            </span>
          </li>
          <li class="site-footer__info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.75"/>
            </svg>
            <a href={`${base}contact#map`} class="site-footer__link">
              <span data-i18n="contact.info.address.value">{t(lang, 'contact.info.address.value')}</span>
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="site-footer__bottom">
    <div class="container">
      <p class="site-footer__copyright">
        <span data-i18n="footer.rights">{t(lang, 'footer.rights')}</span>
        <span class="site-footer__legal-sep" aria-hidden="true">·</span>
        <a href={`${base}privacy`} class="site-footer__legal-link">
          <span data-i18n="privacy.link.label">{t(lang, 'privacy.link.label')}</span>
        </a>
      </p>
    </div>
  </div>
</footer>

<script>
  type EmailAnchor = HTMLAnchorElement & { dataset: { user?: string; domain?: string } };
  type PhoneAnchor = HTMLAnchorElement & { dataset: { cc?: string; rest?: string; display?: string } };

  document.querySelectorAll<EmailAnchor>('.site-footer .obfuscated-email').forEach((a) => {
    const user = a.dataset.user;
    const domain = a.dataset.domain;
    if (!user || !domain) return;
    const address = `${user}@${domain}`;
    a.href = `mailto:${address}`;
    a.textContent = address;
  });

  document.querySelectorAll<PhoneAnchor>('.site-footer .obfuscated-phone').forEach((a) => {
    const cc = a.dataset.cc;
    const rest = a.dataset.rest;
    const display = a.dataset.display ?? rest;
    if (!cc || !rest) return;
    a.href = `tel:+${cc}${rest}`;
    a.textContent = `+${cc} ${display}`;
  });
</script>

<style>
  .site-footer {
    position:   relative;
    background: linear-gradient(160deg, var(--color-primary-dark) 0%, #0f1f4a 100%);
    color:      var(--color-white);
    overflow:   hidden;
  }

  .site-footer__glow {
    position:   absolute;
    top:        -80px;
    right:      -120px;
    width:      480px;
    height:     480px;
    background: radial-gradient(circle, rgba(39, 169, 216, 0.14) 0%, transparent 70%);
    filter:     blur(60px);
    pointer-events: none;
  }

  /* ── Main grid ────────────────────────────────────────────── */
  .site-footer__inner {
    position:        relative;
    z-index:         1;
    padding-top:     var(--space-16);
    padding-bottom:  var(--space-12);
  }

  .site-footer__grid {
    display:               grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap:                   var(--space-10);
    align-items:           start;
  }

  /* ── Brand column ─────────────────────────────────────────── */
  .site-footer__col--brand {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
  }

  .site-footer__logo-link {
    display:    inline-block;
    line-height: 0;
  }

  .site-footer__logo {
    height:      56px;
    width:       auto;
    object-fit:  contain;
    display:     block;
  }

  .site-footer__tagline {
    font-size:   var(--text-sm);
    color:       rgba(255, 255, 255, 0.62);
    line-height: var(--leading-relaxed);
    margin:      0;
    max-width:   200px;
  }

  .site-footer__socials {
    display:    flex;
    gap:        var(--space-3);
    margin-top: var(--space-2);
  }

  .site-footer__social-link {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-2);
    padding:         var(--space-2) var(--space-3);
    background:      rgba(255, 255, 255, 0.08);
    border:          1px solid rgba(255, 255, 255, 0.14);
    border-radius:   var(--radius-md);
    color:           rgba(255, 255, 255, 0.72);
    font-size:       var(--text-sm);
    text-decoration: none;
    transition:
      background      var(--transition-base),
      border-color    var(--transition-base),
      color           var(--transition-base);
  }

  .site-footer__social-link:hover {
    background:   rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.30);
    color:        var(--color-white);
  }

  /* ── Column title ─────────────────────────────────────────── */
  .site-footer__col-title {
    font-family:    var(--font-heading);
    font-weight:    var(--font-weight-semibold);
    font-size:      var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color:          var(--color-secondary);
    margin:         0 0 var(--space-5);
  }

  /* ── Nav links ────────────────────────────────────────────── */
  .site-footer__links {
    list-style:     none;
    padding:        0;
    margin:         0;
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
  }

  .site-footer__link {
    color:           rgba(255, 255, 255, 0.70);
    font-size:       var(--text-sm);
    text-decoration: none;
    transition:      color var(--transition-base);
    line-height:     var(--leading-normal);
  }

  .site-footer__link:hover {
    color: var(--color-white);
  }

  /* ── Info list ────────────────────────────────────────────── */
  .site-footer__info-list {
    list-style:     none;
    padding:        0;
    margin:         0;
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
  }

  .site-footer__info-item {
    display:     flex;
    align-items: flex-start;
    gap:         var(--space-3);
    color:       rgba(255, 255, 255, 0.70);
    font-size:   var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .site-footer__info-item svg {
    flex-shrink: 0;
    margin-top:  2px;
    color:       var(--color-secondary);
    opacity:     0.85;
  }

  .site-footer__phone-row {
    display:        inline-flex;
    flex-wrap:      wrap;
    align-items:    baseline;
    gap:            var(--space-2);
  }

  .site-footer__phone-tag {
    font-size:      var(--text-xs);
    font-weight:    var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color:          rgba(255, 255, 255, 0.45);
  }

  /* ── Bottom bar ───────────────────────────────────────────── */
  .site-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    padding:    var(--space-5) 0;
    position:   relative;
    z-index:    1;
  }

  .site-footer__copyright {
    font-size:   var(--text-sm);
    color:       rgba(255, 255, 255, 0.45);
    text-align:  center;
    margin:      0;
  }

  .site-footer__legal-sep {
    margin-inline: var(--space-2);
  }

  .site-footer__legal-link {
    color:           rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition:      color var(--transition-base);
  }

  .site-footer__legal-link:hover {
    color: var(--color-white);
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap:                   var(--space-10) var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      padding-top:    var(--space-12);
      padding-bottom: var(--space-8);
    }

    .site-footer__grid {
      grid-template-columns: 1fr;
      gap:                   var(--space-8);
    }

    .site-footer__col--brand {
      align-items: center;
      text-align:  center;
    }

    .site-footer__tagline {
      max-width: none;
    }
  }
</style>
