---
import ServiceCard from './ServiceCard.astro';
import Heading from './Heading.astro';
import Section from './Section.astro';
import Container from './Container.astro';
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/* ── SVG Icons ─────────────────────────────────────────────────────────── */

const iconDelivery = `<svg
  xmlns="http://www.w3.org/2000/svg"
  width="28"
  height="28"
  viewBox="2 0 21 21"
  fill="currentColor"
  aria-hidden="true"
>
  <g id="Delivery_Truck">
    <g><path d="M21.47,11.185l-1.03-1.43a2.5,2.5,0,0,0-2.03-1.05H14.03V6.565a2.5,2.5,0,0,0-2.5-2.5H4.56a2.507,2.507,0,0,0-2.5,2.5v9.94a1.5,1.5,0,0,0,1.5,1.5H4.78a2.242,2.242,0,0,0,4.44,0h5.56a2.242,2.242,0,0,0,4.44,0h1.22a1.5,1.5,0,0,0,1.5-1.5v-3.87A2.508,2.508,0,0,0,21.47,11.185ZM7,18.935a1.25,1.25,0,1,1,1.25-1.25A1.25,1.25,0,0,1,7,18.935Zm6.03-1.93H9.15a2.257,2.257,0,0,0-4.3,0H3.56a.5.5,0,0,1-.5-.5V6.565a1.5,1.5,0,0,1,1.5-1.5h6.97a1.5,1.5,0,0,1,1.5,1.5ZM17,18.935a1.25,1.25,0,1,1,1.25-1.25A1.25,1.25,0,0,1,17,18.935Zm3.94-2.43a.5.5,0,0,1-.5.5H19.15a2.257,2.257,0,0,0-4.3,0h-.82v-7.3h4.38a1.516,1.516,0,0,1,1.22.63l1.03,1.43a1.527,1.527,0,0,1,.28.87Z" />
      <path d="M18.029,12.205h-2a.5.5,0,0,1,0-1h2a.5.5,0,0,1,0,1Z" />
    </g>
  </g>
</svg>`;

const iconMaintenance = `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M14 3L5 6.5v7C5 18.5 9 22.5 14 25c5-2.5 9-6.5 9-11.5v-7L14 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  <path d="M10 14l2.5 2.5 5.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

const iconCO2 = `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect x="9" y="5" width="10" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
  <path d="M12 5V3h4v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="14" cy="13" r="1.2" fill="currentColor"/>
  <circle cx="14" cy="9" r="0.8" fill="currentColor" opacity="0.6"/>
  <circle cx="11" cy="11" r="0.8" fill="currentColor" opacity="0.5"/>
  <circle cx="17" cy="11" r="0.8" fill="currentColor" opacity="0.5"/>
</svg>`;

const iconWarehouse = `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M3 12L14 4l11 8v12H3V12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  <rect x="9" y="16" width="4" height="8" rx="1" stroke="currentColor" stroke-width="1.5"/>
  <rect x="15" y="16" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/>
  <path d="M9 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
</svg>`;

const iconLabel = `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M4 4h9l11 11-9 9L4 13V4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  <circle cx="9" cy="9" r="1.8" fill="currentColor"/>
  <path d="M14 17l1.5-3 1.5 3 3 .5-2 2 .5 3-3-1.5-3 1.5.5-3-2-2 3-.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
</svg>`;

const iconSlushy = `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M8 8h12l-2 14H10L8 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  <path d="M6 8h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  <path d="M16 8V5l3-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M11 13h6M11 17h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.7"/>
  <circle cx="9" cy="5" r="1.2" fill="currentColor" opacity="0.6"/>
  <circle cx="7" cy="4" r="0.8" fill="currentColor" opacity="0.4"/>
</svg>`;

/* ── Card data ─────────────────────────────────────────────────────────── */

type CardDef = {
  icon: string;
  titleKey: string;
  descKey: string;
  ctaKey: string;
  ctaHref: string;
};

const homeCards: CardDef[] = [
  {
    icon: iconDelivery,
    titleKey: 'services.home.delivery.title',
    descKey:  'services.home.delivery.body',
    ctaKey:   'services.home.delivery.cta',
    ctaHref:  '/contact',
  },
  {
    icon: iconMaintenance,
    titleKey: 'services.home.maintenance.title',
    descKey:  'services.home.maintenance.body',
    ctaKey:   'services.home.maintenance.cta',
    ctaHref:  '/contact',
  },
  {
    icon: iconCO2,
    titleKey: 'services.home.co2.title',
    descKey:  'services.home.co2.body',
    ctaKey:   'services.home.co2.cta',
    ctaHref:  '/contact',
  },
];

const businessCards: CardDef[] = [
  {
    icon: iconWarehouse,
    titleKey: 'services.business.wholesale.title',
    descKey:  'services.business.wholesale.body',
    ctaKey:   'services.business.wholesale.cta',
    ctaHref:  '/contact',
  },
  {
    icon: iconLabel,
    titleKey: 'services.business.label.title',
    descKey:  'services.business.label.body',
    ctaKey:   'services.business.label.cta',
    ctaHref:  '/contact',
  },
  {
    icon: iconSlushy,
    titleKey: 'services.business.slushy.title',
    descKey:  'services.business.slushy.body',
    ctaKey:   'services.business.slushy.cta',
    ctaHref:  '/contact',
  },
];
---

<Section bg="gray" id="services">
  <Container>

    <!-- ── Section header ─────────────────────────────────────── -->
    <div class="services__header">
      <Heading level={2} align="center">
        <span data-i18n="services.section.title">{t(lang, 'services.section.title')}</span>
      </Heading>
      <p class="services__subtitle">
        <span data-i18n="services.section.subtitle">{t(lang, 'services.section.subtitle')}</span>
      </p>
    </div>

    <!-- ── Tab switcher ───────────────────────────────────────── -->
    <div class="services__tabs-wrap">
      <div
        class="services__tablist"
        role="tablist"
        aria-label="Services"
        id="services-tablist"
      >
        <button
          class="services__tab is-active"
          role="tab"
          aria-selected="true"
          aria-controls="panel-home"
          id="tab-home"
          data-tab="home"
        >
          <span data-i18n="services.tab.home">{t(lang, 'services.tab.home')}</span>
        </button>
        <button
          class="services__tab"
          role="tab"
          aria-selected="false"
          aria-controls="panel-business"
          id="tab-business"
          data-tab="business"
        >
          <span data-i18n="services.tab.business">{t(lang, 'services.tab.business')}</span>
        </button>
      </div>
    </div>

    <!-- ── Tab panels ─────────────────────────────────────────── -->
    <div class="services__panels">

      <div
        id="panel-home"
        class="services__panel is-active"
        role="tabpanel"
        aria-labelledby="tab-home"
      >
        <div class="services__grid">
          {homeCards.map((card) => (
            <ServiceCard
              icon={card.icon}
              title={t(lang, card.titleKey)}
              titleKey={card.titleKey}
              description={t(lang, card.descKey)}
              descKey={card.descKey}
              ctaLabel={t(lang, card.ctaKey)}
              ctaKey={card.ctaKey}
              ctaHref={card.ctaHref}
            />
          ))}
        </div>
      </div>

      <div
        id="panel-business"
        class="services__panel"
        role="tabpanel"
        aria-labelledby="tab-business"
      >
        <div class="services__grid">
          {businessCards.map((card) => (
            <ServiceCard
              icon={card.icon}
              title={t(lang, card.titleKey)}
              titleKey={card.titleKey}
              description={t(lang, card.descKey)}
              descKey={card.descKey}
              ctaLabel={t(lang, card.ctaKey)}
              ctaKey={card.ctaKey}
              ctaHref={card.ctaHref}
            />
          ))}
        </div>
      </div>

    </div>
  </Container>
</Section>

<script>
  const tablist = document.getElementById('services-tablist');
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[data-tab]'));

    function activateTab(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');

      document.querySelectorAll('.services__panel').forEach((panel) => {
        panel.classList.remove('is-active');
      });
      const targetId = `panel-${tab.dataset.tab}`;
      document.getElementById(targetId)?.classList.add('is-active');
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activateTab(tab));
    });

    tablist.addEventListener('keydown', (e: KeyboardEvent) => {
      const current = tabs.findIndex((t) => t === document.activeElement);
      if (e.key === 'ArrowRight' && current < tabs.length - 1) {
        tabs[current + 1].focus();
        activateTab(tabs[current + 1]);
      } else if (e.key === 'ArrowLeft' && current > 0) {
        tabs[current - 1].focus();
        activateTab(tabs[current - 1]);
      }
    });
  }
</script>

<style>
  /* ── Header ───────────────────────────────────────────────── */
  .services__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .services__subtitle {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Tab switcher ─────────────────────────────────────────── */
  .services__tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-10);
  }

  .services__tablist {
    display: inline-flex;
    background: var(--color-border-light);
    border-radius: var(--radius-full);
    padding: var(--space-1);
    gap: var(--space-1);
  }

  .services__tab {
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-full);
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--transition-base),
      color            var(--transition-base),
      box-shadow       var(--transition-base);
  }

  .services__tab:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .services__tab.is-active {
    background-color: var(--color-primary);
    color:            var(--color-white);
    box-shadow:       var(--shadow-sm);
  }

  .services__tab:not(.is-active):hover {
    color: var(--color-text);
    background-color: rgba(0, 0, 0, 0.04);
  }

  /* ── Panels - stacked in CSS grid for smooth crossfade ───── */
  .services__panels {
    display: grid;
  }

  .services__panel {
    grid-column: 1;
    grid-row: 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity        var(--transition-slow),
      visibility     var(--transition-slow),
      transform      var(--transition-slow);
    pointer-events: none;
  }

  .services__panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ── Card grid ────────────────────────────────────────────── */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    align-items: stretch;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .services__tab {
      padding: var(--space-3) var(--space-5);
      font-size: var(--text-sm);
    }

    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
