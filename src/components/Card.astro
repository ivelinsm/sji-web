---
interface Props {
  accent?: boolean;
  href?: string;
  padding?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  accent = false,
  href,
  padding = 'md',
  class: className,
} = Astro.props;

const classes = [
  'card',
  `card--pad-${padding}`,
  accent && 'card--accent',
  href   && 'card--link',
  className,
];
---

{href ? (
  <a href={href} class:list={classes}>
    <slot />
  </a>
) : (
  <div class:list={classes}>
    <slot />
  </div>
)}

<style>
  .card {
    background-color: var(--color-surface);
    border-radius:    var(--radius-lg);
    box-shadow:       var(--shadow-md);
    position:         relative;
    overflow:         hidden;
    display:          block;
    color:            inherit;
    text-decoration:  none;
    transition:
      box-shadow var(--transition-base),
      transform  var(--transition-base);
  }

  /* ── Padding variants ───────────────────────────────────── */
  .card--pad-sm { padding: var(--space-4); }
  .card--pad-md { padding: var(--space-8); }
  .card--pad-lg { padding: var(--space-12); }

  /* ── Accent top border (aqua line) ──────────────────────── */
  .card--accent::before {
    content:          '';
    position:         absolute;
    inset-block-start: 0;
    inset-inline:     0;
    height:           4px;
    background-color: var(--color-secondary);
    border-radius:    var(--radius-lg) var(--radius-lg) 0 0;
  }

  /* ── Hover state for link cards ─────────────────────────── */
  .card--link:hover {
    box-shadow: var(--shadow-lg);
    transform:  translateY(-2px);
  }
</style>
