---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'ghost-white' | 'ghost-white-primary';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  size = 'md',
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, className];
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    border-radius: var(--radius-full);
    border: 2px solid transparent;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--transition-base),
      color            var(--transition-base),
      border-color     var(--transition-base),
      box-shadow       var(--transition-base),
      transform        var(--transition-base);
  }

  /* ── Sizes ─────────────────────────────────────────────── */
  .btn--sm {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
  }

  .btn--md {
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-6);
  }

  .btn--lg {
    font-size: var(--text-lg);
    padding: var(--space-4) var(--space-8);
  }

  /* ── Hover lift (shared) ────────────────────────────────── */
  .btn:hover {
    /* transform: translateY(-2px); */
  }

  .btn:active {
    transform: translateY(0);
  }

  /* ── Primary ────────────────────────────────────────────── */
  .btn--primary {
    background-color: var(--color-primary);
    color:            var(--color-white);
    border-color:     var(--color-primary);
  }

  .btn--primary:hover {
    background-color: var(--color-primary-hover);
    border-color:     var(--color-primary-hover);
    box-shadow:       var(--shadow-hover);
  }

  /* ── Secondary ──────────────────────────────────────────── */
  .btn--secondary {
    background-color: var(--color-secondary);
    color:            var(--color-white);
    border-color:     var(--color-secondary);
  }

  .btn--secondary:hover {
    background-color: var(--color-secondary-hover);
    border-color:     var(--color-secondary-hover);
    box-shadow:       0 8px 28px rgba(39, 169, 216, 0.20);
  }

  /* ── Ghost ──────────────────────────────────────────────── */
  .btn--ghost {
    background-color: transparent;
    color:            var(--color-primary);
    border-color:     var(--color-primary);
  }

  .btn--ghost:hover {
    background-color: var(--color-primary);
    color:            var(--color-white);
    box-shadow:       var(--shadow-hover);
  }

  /* ── Ghost White (for use on dark/image backgrounds) ────── */
  .btn--ghost-white {
    background-color: transparent;
    color:            var(--color-white);
    border-color:     var(--color-white);
  }

  .btn--ghost-white:hover {
    background-color: var(--color-white);
    color:            var(--color-primary);
    box-shadow:       0 8px 28px rgba(255, 255, 255, 0.18);
  }

  /* ── Ghost White Primary ─────────────────────────────────── */

  .btn--ghost-white-primary {
    background-color: var(--color-bg);
    color:            var(--color-primary-hover);
    border-color:     var(--color-bg);
  }

  .btn--ghost-white-primary:hover {
    background-color: var(--color-white);
    color:            var(--color-primary);
    box-shadow:       0 8px 28px rgba(255, 255, 255, 0.18);
  }
</style>
