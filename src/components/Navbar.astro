---
interface Props {
  variant?: 'light' | 'dark' | 'transparent';
}

const { variant = 'light' } = Astro.props;
---

<nav class:list={['navbar', `navbar--${variant}`]} aria-label="Main navigation">
  <div class="navbar__inner container">

    <div class="navbar__logo">
      <slot name="logo" />
    </div>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="navbar-links navbar-actions"
      data-nav-toggle
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="sr-only" data-i18n="nav.menu.aria">Меню</span>
    </button>

    <div class="navbar__links" id="navbar-links">
      <slot name="links" />
    </div>

    <div class="navbar__actions" id="navbar-actions">
      <slot name="actions" />
    </div>

  </div>
</nav>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]').forEach((btn) => {
    const nav = btn.closest('.navbar');
    if (!nav) return;

    const setOpen = (open: boolean) => {
      nav.classList.toggle('navbar--open', open);
      btn.setAttribute('aria-expanded', String(open));
    };

    btn.addEventListener('click', () => {
      setOpen(!nav.classList.contains('navbar--open'));
    });

    nav.addEventListener('keydown', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Escape' && nav.classList.contains('navbar--open')) {
        setOpen(false);
        btn.focus();
      }
    });
  });
</script>

<style>
  .navbar {
    position:      sticky;
    top:           0;
    z-index:       100;
    width:         100%;
    border-bottom: 1px solid var(--color-border-light);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* ── Variants ───────────────────────────────────────────── */
  .navbar--light {
    background-color: rgba(255, 255, 255, 0.95);
    color:            var(--color-text);
  }

  .navbar--dark {
    background-color: rgba(47, 85, 151, 0.97);
    color:            var(--color-white);
    border-bottom-color: rgba(255, 255, 255, 0.10);
  }

  .navbar--transparent {
    background-color: rgba(0, 0, 0, 0.1);
    backdrop-filter:  blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-bottom:    none;
    color:            var(--color-white);
    --nav-link-accent: var(--color-white);
  }

  /* ── Inner layout ───────────────────────────────────────── */
  .navbar__inner {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             var(--space-6);
    height:          72px;
  }

  .navbar__logo {
    flex-shrink: 0;
  }

  .navbar__links {
    display:         flex;
    align-items:     center;
    gap:             var(--space-10);
    flex:            1;
    justify-content: end;
    margin-right: var(--space-5)
  }

  .navbar__actions {
    display:     flex;
    align-items: center;
    gap:         var(--space-3);
    flex-shrink: 0;
  }

  /* ── Mobile toggle button ───────────────────────────────── */
  .nav-toggle {
    display:    none;
    background: transparent;
    border:     none;
    color:      inherit;
    cursor:     pointer;
    padding:    var(--space-2);
  }

  .nav-toggle:focus-visible {
    outline:        2px solid var(--color-secondary);
    outline-offset: 2px;
    border-radius:  var(--radius-sm);
  }

  .nav-toggle__bar {
    display:          block;
    width:            24px;
    height:           2px;
    background-color: currentColor;
    border-radius:    var(--radius-full);
    transition:       transform var(--transition-base), opacity var(--transition-base);
  }

  .nav-toggle__bar + .nav-toggle__bar {
    margin-top: 5px;
  }

  /* ── Responsive: Mobile ─────────────────────────────────── */
  @media (max-width: 768px) {
    .nav-toggle {
      display:        flex;
      flex-direction: column;
      position:       relative;
      z-index:        20;
    }

    .navbar__links,
    .navbar__actions {
      display:    none;
      position:   absolute;
      top:        72px;
      left:       0;
      right:      0;
      width:      100%;
      padding:    var(--space-5) var(--space-6);
      z-index:    10;
    }

    .navbar__links {
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    }

    .navbar--light .navbar__links {
      border-bottom-color: var(--color-border-light);
    }

    .navbar--light .navbar__links,
    .navbar--light .navbar__actions {
      background-color: var(--color-surface);
    }

    .navbar--dark .navbar__links,
    .navbar--dark .navbar__actions {
      background-color: var(--color-primary);
    }

    .navbar--transparent .navbar__links,
    .navbar--transparent .navbar__actions {
      background-color: rgba(10, 20, 60, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .navbar__links {
      flex-direction: column;
      align-items:    flex-start;
      gap:            var(--space-4);
    }

    .navbar__actions {
      top:        auto;
      flex-wrap:  wrap;
    }

    /* When the menu is open, show links + actions */
    .navbar--open .navbar__links,
    .navbar--open .navbar__actions {
      display: flex;
    }

    /* Animate hamburger to X */
    .navbar--open .nav-toggle__bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .navbar--open .nav-toggle__bar:nth-child(2) {
      opacity: 0;
    }

    .navbar--open .nav-toggle__bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
