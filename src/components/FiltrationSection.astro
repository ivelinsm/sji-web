---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

import phase1 from '../assets/phase1.webp';
import phase2 from '../assets/phase2.webp';
import phase3 from '../assets/phase3.webp';
import phase4 from '../assets/phase4.webp';
import phase5 from '../assets/phase5.webp';
import phase6 from '../assets/phase6.webp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type Phase = {
  num: number;
  pad: string;
  image: ImageMetadata;
  titleKey: string;
  bodyKey: string;
};

const phases: Phase[] = [
  { num: 1, pad: '01', image: phase1, titleKey: 'filtration.phase1.title', bodyKey: 'filtration.phase1.body' },
  { num: 2, pad: '02', image: phase2, titleKey: 'filtration.phase2.title', bodyKey: 'filtration.phase2.body' },
  { num: 3, pad: '03', image: phase3, titleKey: 'filtration.phase3.title', bodyKey: 'filtration.phase3.body' },
  { num: 4, pad: '04', image: phase4, titleKey: 'filtration.phase4.title', bodyKey: 'filtration.phase4.body' },
  { num: 5, pad: '05', image: phase5, titleKey: 'filtration.phase5.title', bodyKey: 'filtration.phase5.body' },
  { num: 6, pad: '06', image: phase6, titleKey: 'filtration.phase6.title', bodyKey: 'filtration.phase6.body' },
];
---

<Section bg="gray" id="filtration" size="lg">
  <Container>

    <!-- ── Section header ──────────────────────────────────────── -->
    <header class="filt__header">
      <span class="filt__eyebrow" data-i18n="filtration.eyebrow">{t(lang, 'filtration.eyebrow')}</span>
      <Heading level={2} align="center">
        <span data-i18n="filtration.section.title">{t(lang, 'filtration.section.title')}</span>
      </Heading>
      <p class="filt__subtitle">
        <span data-i18n="filtration.section.subtitle">{t(lang, 'filtration.section.subtitle')}</span>
      </p>
      <p class="filt__lead">
        <span data-i18n="filtration.section.lead">{t(lang, 'filtration.section.lead')}</span>
      </p>
    </header>

    <!-- ── Mobile horizontal pill nav ──────────────────────────── -->
    <nav
      class="filt__mobile-nav"
      aria-label={t(lang, 'filtration.nav.aria')}
      data-filt-mobile-nav
    >
      <ol class="filt__mobile-list" role="list">
        {phases.map((p, i) => (
          <li class={`filt__mobile-item ${i === 0 ? 'is-active' : ''}`} data-mobile-step={i}>
            <a href={`#filtration-phase-${p.num}`} class="filt__mobile-pill">
              <span class="filt__mobile-num" aria-hidden="true">{p.pad}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <!-- ── Main split layout (rail + horizontal slideshow) ────── -->
    <div class="filt__layout">

      <!-- Timeline rail (non-sticky) -->
      <aside class="filt__rail" aria-label={t(lang, 'filtration.nav.aria')}>
        <div class="filt__rail-inner" data-filt-rail>

          <span class="filt__rail-eyebrow" data-i18n="filtration.eyebrow">
            {t(lang, 'filtration.eyebrow')}
          </span>

          <ol class="filt__steps" role="list">
            <span class="filt__progress" aria-hidden="true">
              <span class="filt__progress-fill"></span>
            </span>

            {phases.map((p, i) => (
              <li class={`filt__step ${i === 0 ? 'is-active' : ''}`} data-step={i}>
                <a
                  href={`#filtration-phase-${p.num}`}
                  class="filt__step-link"
                  aria-current={i === 0 ? 'step' : undefined}
                >
                  <span class="filt__step-num" aria-hidden="true">{p.pad}</span>
                  <span class="filt__step-label" data-i18n={p.titleKey}>
                    {t(lang, p.titleKey)}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </aside>

      <!-- Horizontal slideshow -->
      <div class="filt__slideshow">

        <button
          type="button"
          class="filt__nav filt__nav--prev"
          data-filt-prev
          aria-label="Previous stage"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M12.5 4l-6 6 6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <button
          type="button"
          class="filt__nav filt__nav--next"
          data-filt-next
          aria-label="Next stage"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M7.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div
          class="filt__viewport"
          data-filt-viewport
          role="region"
          aria-roledescription="carousel"
          aria-label={t(lang, 'filtration.nav.aria')}
          tabindex="0"
        >
          <div class="filt__content" data-filt-content>
            {phases.map((p, i) => (
              <article
                class="filt__phase"
                id={`filtration-phase-${p.num}`}
                data-phase={i}
                aria-roledescription="slide"
                aria-label={`${t(lang, 'filtration.phase.label')} ${p.pad}`}
              >
                <div class="filt__media">
                  <Image
                    src={p.image}
                    alt=""
                    class="filt__img"
                    widths={[480, 720, 960, 1280]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1100px) 50vw, 560px"
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                  <span class="filt__media-badge" aria-hidden="true">
                    <span class="filt__media-badge-label" data-i18n="filtration.phase.label">
                      {t(lang, 'filtration.phase.label')}
                    </span>
                    <span class="filt__media-badge-num">{p.pad}</span>
                  </span>
                  <span class="filt__media-numeral" aria-hidden="true">{p.pad}</span>
                </div>

                <div class="filt__text">
                  <span class="filt__phase-tag">
                    <span class="filt__phase-tag-dot" aria-hidden="true"></span>
                    <span data-i18n="filtration.phase.label">{t(lang, 'filtration.phase.label')}</span>
                    &nbsp;<span class="filt__phase-tag-num">{p.pad}</span>
                  </span>
                  <h3 class="filt__phase-title">
                    <span data-i18n={p.titleKey}>{t(lang, p.titleKey)}</span>
                  </h3>
                  <p class="filt__phase-body">
                    <span data-i18n={p.bodyKey}>{t(lang, p.bodyKey)}</span>
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Slide counter / dots (decorative) -->
        <div class="filt__dots" aria-hidden="true">
          {phases.map((p, i) => (
            <span class={`filt__dot ${i === 0 ? 'is-active' : ''}`} data-dot={i}></span>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>

<script>
  (() => {
    const rail = document.querySelector<HTMLElement>('[data-filt-rail]');
    const mobileNav = document.querySelector<HTMLElement>('[data-filt-mobile-nav]');
    const viewport = document.querySelector<HTMLElement>('[data-filt-viewport]');
    const content = document.querySelector<HTMLElement>('[data-filt-content]');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-filt-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-filt-next]');
    if (!rail || !mobileNav || !viewport || !content) return;

    const phaseEls = Array.from(content.querySelectorAll<HTMLElement>('.filt__phase'));
    const stepEls = Array.from(rail.querySelectorAll<HTMLElement>('.filt__step'));
    const stepLinks = Array.from(rail.querySelectorAll<HTMLAnchorElement>('.filt__step-link'));
    const mobileItems = Array.from(mobileNav.querySelectorAll<HTMLElement>('.filt__mobile-item'));
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.filt__dot'));
    if (!phaseEls.length) return;

    const total = phaseEls.length;
    let activeIndex = 0;

    function setActive(idx: number) {
      idx = Math.max(0, Math.min(total - 1, idx));
      if (idx === activeIndex) return;
      activeIndex = idx;

      stepEls.forEach((el, i) => {
        el.classList.toggle('is-active', i === idx);
        el.classList.toggle('is-passed', i < idx);
      });
      stepLinks.forEach((link, i) => {
        if (i === idx) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
      mobileItems.forEach((el, i) => {
        el.classList.toggle('is-active', i === idx);
      });
      dots.forEach((el, i) => {
        el.classList.toggle('is-active', i === idx);
      });

      const pct = total <= 1 ? 100 : (idx / (total - 1)) * 100;
      rail.style.setProperty('--filt-progress', `${pct}%`);

      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) nextBtn.disabled = idx === total - 1;

      // Keep the active mobile pill horizontally centered
      const activeMobile = mobileItems[idx];
      if (activeMobile) {
        const list = activeMobile.parentElement?.parentElement;
        if (list) {
          const target =
            activeMobile.offsetLeft - list.clientWidth / 2 + activeMobile.clientWidth / 2;
          list.scrollTo({ left: target, behavior: 'smooth' });
        }
      }
    }

    function reduceMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function goToSlide(idx: number) {
      idx = Math.max(0, Math.min(total - 1, idx));
      const slide = phaseEls[idx];
      if (!slide) return;
      // offsetLeft is relative to the offset parent (the track); scrollLeft on
      // viewport positions the slide at the left edge.
      viewport!.scrollTo({
        left: slide.offsetLeft,
        behavior: reduceMotion() ? 'auto' : 'smooth',
      });
    }

    // Update active index based on current scroll position.
    let rafId: number | null = null;
    function syncFromScroll() {
      rafId = null;
      const slideWidth = viewport!.clientWidth;
      if (slideWidth === 0) return;
      const idx = Math.round(viewport!.scrollLeft / slideWidth);
      setActive(idx);
    }
    viewport.addEventListener('scroll', () => {
      if (rafId !== null) return;
      rafId = window.requestAnimationFrame(syncFromScroll);
    }, { passive: true });

    // Recompute on resize (slide widths change with the viewport).
    window.addEventListener('resize', () => {
      // Snap back to the active slide so it stays aligned.
      goToSlide(activeIndex);
    });

    // Rail / mobile pill clicks → scroll viewport horizontally instead of jumping.
    [
      ...stepLinks,
      ...mobileNav.querySelectorAll<HTMLAnchorElement>('.filt__mobile-pill'),
    ].forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#filtration-phase-')) return;
        const num = parseInt(href.replace('#filtration-phase-', ''), 10);
        if (Number.isNaN(num)) return;
        e.preventDefault();
        goToSlide(num - 1);
      });
    });

    // Prev / next arrow buttons
    prevBtn?.addEventListener('click', () => goToSlide(activeIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(activeIndex + 1));

    // Keyboard navigation on the rail (Up/Down/Left/Right/Home/End)
    rail.addEventListener('keydown', (e: KeyboardEvent) => {
      const current = stepLinks.findIndex((l) => l === document.activeElement);
      if (current === -1) return;
      let nextIdx = current;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') nextIdx = Math.min(total - 1, current + 1);
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') nextIdx = Math.max(0, current - 1);
      else if (e.key === 'Home') nextIdx = 0;
      else if (e.key === 'End') nextIdx = total - 1;
      else return;
      e.preventDefault();
      stepLinks[nextIdx].focus();
      goToSlide(nextIdx);
    });

    // Keyboard navigation on the slideshow viewport itself
    viewport.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goToSlide(activeIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goToSlide(activeIndex - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        goToSlide(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        goToSlide(total - 1);
      }
    });

    // Initialize button disabled state.
    if (prevBtn) prevBtn.disabled = true;
    if (nextBtn) nextBtn.disabled = total <= 1;
  })();
</script>

<style>
  /* ── Section header ──────────────────────────────────────────── */
  .filt__header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  .filt__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-4);
  }

  .filt__subtitle {
    margin-top: var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    letter-spacing: -0.01em;
  }

  .filt__lead {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }

  /* ── Layout: rail + horizontal slideshow ─────────────────────── */
  .filt__layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-16);
    align-items: start;
    /* Prevent the slideshow column from blowing out the grid horizontally. */
    min-width: 0;
  }

  /* ── Timeline rail (non-sticky) ─────────────────────────────── */
  .filt__rail {
    position: relative;
    min-width: 0;
  }

  .filt__rail-inner {
    --filt-progress: 0%;
  }

  .filt__rail-eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-left: calc(28px + var(--space-4));
    margin-bottom: var(--space-2);
  }

  .filt__steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .filt__progress {
    position: absolute;
    left: 13px;
    top: 14px;
    bottom: 14px;
    width: 2px;
    background-color: var(--color-border-light);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .filt__progress-fill {
    display: block;
    width: 100%;
    height: var(--filt-progress, 0%);
    background: linear-gradient(
      to bottom,
      var(--color-secondary) 0%,
      var(--color-primary) 100%
    );
    border-radius: var(--radius-full);
    transition: height 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .filt__step {
    position: relative;
    margin: 0;
  }

  .filt__step-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: color var(--transition-base), transform var(--transition-base);
  }

  .filt__step-link:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 4px;
  }

  .filt__step-num {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    border: 2px solid var(--color-border-light);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    letter-spacing: 0;
    transition:
      background-color var(--transition-slow),
      border-color var(--transition-slow),
      color var(--transition-slow),
      transform var(--transition-slow),
      box-shadow var(--transition-slow);
  }

  .filt__step-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    transition: color var(--transition-base);
  }

  /* Hover */
  .filt__step:not(.is-active) .filt__step-link:hover {
    color: var(--color-text);
    transform: translateX(2px);
  }
  .filt__step:not(.is-active) .filt__step-link:hover .filt__step-num {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }

  /* Passed */
  .filt__step.is-passed .filt__step-num {
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
    color: var(--color-white);
  }
  .filt__step.is-passed .filt__step-link {
    color: var(--color-text);
  }

  /* Active */
  .filt__step.is-active .filt__step-link {
    color: var(--color-primary);
  }
  .filt__step.is-active .filt__step-label {
    font-weight: var(--font-weight-semibold);
  }
  .filt__step.is-active .filt__step-num {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
    transform: scale(1.08);
    box-shadow: 0 0 0 6px var(--color-secondary-alpha-10);
  }

  /* ── Mobile pill nav ────────────────────────────────────────── */
  .filt__mobile-nav {
    display: none;
    margin: 0 calc(-1 * var(--container-padding)) var(--space-8);
    padding: var(--space-3) 0;
  }

  .filt__mobile-list {
    display: flex;
    gap: var(--space-2);
    padding: 0 var(--container-padding);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .filt__mobile-list::-webkit-scrollbar { display: none; }

  .filt__mobile-item {
    flex-shrink: 0;
    scroll-snap-align: center;
  }

  .filt__mobile-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--transition-base),
      color var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .filt__mobile-num {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    color: var(--color-secondary);
  }

  .filt__mobile-item.is-active .filt__mobile-pill {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
    box-shadow: var(--shadow-md);
  }
  .filt__mobile-item.is-active .filt__mobile-num {
    color: var(--color-white);
    opacity: 0.85;
  }

  /* ── Slideshow shell ────────────────────────────────────────── */
  .filt__slideshow {
    position: relative;
    min-width: 0;
  }

  .filt__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    border-radius: var(--radius-2xl);
    outline: none;
  }
  .filt__viewport::-webkit-scrollbar { display: none; }

  .filt__viewport:focus-visible {
    box-shadow: 0 0 0 3px var(--color-secondary-alpha-10);
  }

  .filt__content {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 0;
    width: 100%;
  }

  .filt__phase {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
    padding: var(--space-2);
  }

  /* ── Phase media ────────────────────────────────────────────── */
  .filt__media {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: var(--color-primary);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 18px 50px rgba(15, 23, 42, 0.10);
    isolation: isolate;
  }

  .filt__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 18, 55, 0.0) 50%,
      rgba(8, 18, 55, 0.42) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .filt__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .filt__media-badge {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    z-index: 2;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
  }

  .filt__media-badge-num {
    font-family: var(--font-heading);
    color: var(--color-secondary);
    font-size: var(--text-sm);
  }

  .filt__media-numeral {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-3);
    z-index: 2;
    font-family: var(--font-heading);
    font-size: clamp(var(--text-5xl), 7vw, 6rem);
    font-weight: var(--font-weight-bold);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 6px 32px rgba(8, 18, 55, 0.45);
    pointer-events: none;
  }

